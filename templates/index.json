    "vanaya_faq": {
      "type": "vanaya-faq",
      "blocks": {
        "f1": {
          "type": "question",
          "settings": {
            "question": "Are Vanaya products suitable for Indian skin?",
            "answer": "Yes. Vanaya rituals are thoughtfully created around Indian skin, our climate and common concerns. Please review the individual product directions before use."
          }
        },
        "f2": {
          "type": "question",
          "settings": {
            "question": "How do I choose the right ritual?",
            "answer": "Start with your primary skin concern—dullness, uneven tone, dryness or early signs of ageing. Each product page explains the recommended ritual and usage."
          }
        },
        "f3": {
          "type": "question",
          "settings": {
            "question": "Can I use the oils every day?",
            "answer": "Most facial oils can be used regularly in small quantities. Begin with two or three drops and adjust the frequency according to your skin’s comfort."
          }
        },
        "f4": {
          "type": "question",
          "settings": {
            "question": "Are the products made using Ayurvedic principles?",
            "answer": "Vanaya brings time-honoured Ayurvedic ingredients and Shastrokt-inspired preparation together with a modern skincare experience."
          }
        },
        "f5": {
          "type": "question",
          "settings": {
            "question": "How long will delivery take?",
            "answer": "Orders are generally dispatched within 1–2 working days. Delivery time varies by location and will be shown during checkout."
          }
        },
        "f6": {
          "type": "question",
          "settings": {
            "question": "Can I gift a Vanaya ritual?",
            "answer": "Yes. Our curated gifting rituals are designed for meaningful occasions, festive moments and thoughtful everyday gestures."
          }
        }
