<style id="vanaya-visual-fixes-20260922">
    /* Our Story: the 'Considered at every step' panel is page content, not the theme section.
       JS below identifies that exact panel and adds this class. */
    .vanaya-story-contrast-fix,
    .vanaya-story-contrast-fix *{color:#fff!important}
    .vanaya-story-contrast-fix a{color:#fff!important;border-color:rgba(255,255,255,.7)!important}

    /* Cart recently viewed cards */
    .template-cart .recently-viewed-products .product-card figure,
    .template-cart .recently-viewed-products .product-card figure > a,
    .template-cart .recently-viewed-products .product-card picture{
      overflow:hidden!important;
    }
    .template-cart .recently-viewed-products .product-card img{
      object-fit:contain!important;
      object-position:center!important;
    }
  </style>
  <script>
  document.addEventListener('DOMContentLoaded', function () {
    /* OUR STORY: find the exact panel even when Shopify page HTML wraps the heading. */
    if ({{ page.handle | json }} === 'our-story') {
      var all = Array.from(document.querySelectorAll('#content *'));
      var marker = all.find(function(el){
        var t=(el.textContent||'').replace(/\s+/g,' ').trim().toLowerCase();
        return t.indexOf('considered at every step') !== -1 && el.children.length < 6;
      });
      if (marker) {
        var panel=marker;
        for(var i=0;i<8 && panel && panel!==document.body;i++){
          var txt=(panel.textContent||'').toLowerCase();
          var hasSteps = txt.indexOf('source')>-1 && txt.indexOf('formulate')>-1 && txt.indexOf('manufacture')>-1 && txt.indexOf('deliver')>-1;
          if(hasSteps) break;
          panel=panel.parentElement;
        }
        if(panel && panel!==document.body){
          panel.classList.add('vanaya-story-contrast-fix');
          panel.querySelectorAll('*').forEach(function(el){el.style.setProperty('color','#fff','important')});
          panel.style.setProperty('color','#fff','important');
        }
      }
    }

    /* CART: Shopify's product card may request a cropped CDN rendition.
       Remove crop/height from dynamically injected recently-viewed images. */
    {
      function unCropUrl(raw) {
        if (!raw) return raw;
        try {
          var u = new URL(raw, window.location.origin);
          u.searchParams.delete('height');
          u.searchParams.delete('crop');
          return u.toString();
        } catch(e) {
          return raw.replace(/([?&])height=[^&]+&?/g,'$1').replace(/([?&])crop=[^&]+&?/g,'$1').replace(/[?&]$/,'');
        }
      }
      function fixRecentImages(root) {
        (root || document).querySelectorAll('.recently-viewed-products img').forEach(function(img){
          var src=img.getAttribute('src');
          if(src) img.setAttribute('src',unCropUrl(src));
          var ss=img.getAttribute('srcset');
          if(ss){
            img.setAttribute('srcset',ss.split(',').map(function(part){
              var bits=part.trim().split(/\s+/);
              bits[0]=unCropUrl(bits[0]);
              return bits.join(' ');
            }).join(', '));
          }
          img.classList.remove('filled');
          img.style.setProperty('object-fit','contain','important');
          img.style.setProperty('object-position','center','important');
          img.style.setProperty('width','100%','important');
          img.style.setProperty('height','100%','important');
        });
      }
      fixRecentImages(document);
      new MutationObserver(function(){fixRecentImages(document)}).observe(document.body,{childList:true,subtree:true});
    }
  });
  </script>
</head>
  <body class="template-{{ template.name | handle }}">
