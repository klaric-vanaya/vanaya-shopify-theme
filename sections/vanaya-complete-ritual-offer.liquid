<section class="vcr-offer" id="free-gift-offer">
  <div class="vcr-offer__inner">
    <div class="vcr-offer__intro">
      <span class="vcr-offer__eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>

    <div class="vcr-offer__tiers">
      <div class="vcr-offer__tier">
        <span class="vcr-offer__amount">₹1,599+</span>
        <div>
          <b>Choose a FREE gift</b>
          <p>Pick any eligible product up to ₹349.</p>
        </div>
      </div>
      <div class="vcr-offer__tier vcr-offer__tier--best">
        <span class="vcr-offer__amount">₹2,599+</span>
        <div>
          <b>Unlock a bigger FREE gift</b>
          <p>Pick any eligible product up to ₹899.</p>
        </div>
      </div>
    </div>

    <a class="vcr-offer__cta" href="{{ section.settings.link | default: routes.all_products_collection_url }}">
      {{ section.settings.link_text }} <span aria-hidden="true">→</span>
    </a>
  </div>
  <div class="vcr-offer__foot">One free gift per order · Automatically applied when your cart qualifies</div>
</section>

<style>
  #shopify-section-{{ section.id }}{margin:0!important;padding:0!important;background:#d4d2b4}
  #shopify-section-{{ section.id }} .vcr-offer{margin:0!important;background:#d4d2b4;color:#4b3929}
  #shopify-section-{{ section.id }} .vcr-offer__inner{
    display:grid;grid-template-columns:1.05fr 1.55fr auto;gap:28px;align-items:center;
    padding:18px max(26px,4vw) 16px
  }
  #shopify-section-{{ section.id }} .vcr-offer__intro{min-width:0}
  #shopify-section-{{ section.id }} .vcr-offer__eyebrow{
    display:block;margin-bottom:4px;color:#735a3f;font-size:8px;font-weight:800;
    letter-spacing:.18em;text-transform:uppercase
  }
  #shopify-section-{{ section.id }} .vcr-offer__intro h2{
    margin:0 0 5px;color:#4b3929;font:500 clamp(24px,2.3vw,36px)/1 Georgia,"Times New Roman",serif
  }
  #shopify-section-{{ section.id }} .vcr-offer__intro p{margin:0;max-width:520px;color:#6a543c;font-size:11px;line-height:1.45}
  #shopify-section-{{ section.id }} .vcr-offer__tiers{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  #shopify-section-{{ section.id }} .vcr-offer__tier{
    display:flex;align-items:center;gap:13px;min-height:74px;padding:12px 15px;
    border:1px solid rgba(90,70,50,.2);background:rgba(255,250,240,.42)
  }
  #shopify-section-{{ section.id }} .vcr-offer__tier--best{background:#5a4632;color:#fff8e9}
  #shopify-section-{{ section.id }} .vcr-offer__amount{
    flex:0 0 auto;color:#5a4632;font:500 22px/1 Georgia,"Times New Roman",serif
  }
  #shopify-section-{{ section.id }} .vcr-offer__tier--best .vcr-offer__amount{color:#fff8e9}
  #shopify-section-{{ section.id }} .vcr-offer__tier b{display:block;margin-bottom:3px;font-size:12px}
  #shopify-section-{{ section.id }} .vcr-offer__tier p{margin:0;font-size:10px;line-height:1.35;opacity:.82}
  #shopify-section-{{ section.id }} .vcr-offer__cta{
    display:inline-flex;align-items:center;gap:8px;white-space:nowrap;padding:10px 17px;
    border:1px solid #5a4632;border-radius:999px;background:#5a4632;color:#fffaf0!important;
    text-decoration:none!important;font-size:9px;font-weight:800;letter-spacing:.1em;text-transform:uppercase
  }
  #shopify-section-{{ section.id }} .vcr-offer__foot{
    padding:7px 18px;background:#4b3929;color:#d4d2b4;text-align:center;
    font-size:8px;font-weight:700;letter-spacing:.08em;text-transform:uppercase
  }
  .template-index #shopify-section-vanaya_video + #shopify-section-vanaya_complete_ritual_offer,
  .template-index #shopify-section-vanaya_complete_ritual_offer + #shopify-section-vanaya_new{
    margin-top:0!important;margin-bottom:0!important;padding-top:0!important;padding-bottom:0!important
  }
  .template-index #shopify-section-vanaya_complete_ritual_offer + #shopify-section-vanaya_new .vanaya-section{
    margin-top:0!important;padding-top:28px!important
  }
  @media(max-width:900px){
    #shopify-section-{{ section.id }} .vcr-offer__inner{grid-template-columns:1fr;padding:16px 20px;gap:14px;text-align:center}
    #shopify-section-{{ section.id }} .vcr-offer__intro p{margin-left:auto;margin-right:auto}
    #shopify-section-{{ section.id }} .vcr-offer__cta{justify-self:center}
  }
  @media(max-width:600px){
    #shopify-section-{{ section.id }} .vcr-offer__tiers{grid-template-columns:1fr}
    #shopify-section-{{ section.id }} .vcr-offer__tier{text-align:left}
    #shopify-section-{{ section.id }} .vcr-offer__intro h2{font-size:27px}
    .template-index #shopify-section-vanaya_complete_ritual_offer + #shopify-section-vanaya_new .vanaya-section{padding-top:18px!important}
  }
</style>

{% schema %}
{
  "name":"Vanaya Free Gift Offer",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"A Little Gift, On Us"},
    {"type":"text","id":"heading","label":"Heading","default":"Your Ritual Comes With Something Extra."},
    {"type":"textarea","id":"text","label":"Text","default":"Build your Vanaya ritual and choose a complimentary gift when your cart reaches the qualifying value."},
    {"type":"url","id":"link","label":"Shop link"},
    {"type":"text","id":"link_text","label":"Button text","default":"Shop & Unlock Your Gift"}
  ],
  "presets":[{"name":"Vanaya Free Gift Offer"}]
}
{% endschema %}
