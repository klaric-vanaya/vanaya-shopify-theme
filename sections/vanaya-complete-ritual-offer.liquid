<section class="vcr-offer" id="complete-ritual-offer">
  <div class="vcr-offer__ornament vcr-offer__ornament--left" aria-hidden="true">✦</div>
  <div class="vcr-offer__ornament vcr-offer__ornament--right" aria-hidden="true">❈</div>

  <div class="vcr-offer__inner">
    <div class="vcr-offer__intro">
      <span class="vcr-offer__eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>

    <div class="vcr-offer__hero">
      <span class="vcr-offer__label">Vanaya Complete Discount</span>
      <strong>20<span>%</span> OFF</strong>
      <p>on 4+ products</p>
      <a href="{{ section.settings.link | default: routes.all_products_collection_url }}">
        {{ section.settings.link_text }}
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="vcr-offer__seal" aria-label="Buy four or more and save twenty percent">
      <small>COMPLETE RITUAL</small>
      <b>BUY 4+</b>
      <span>SAVE 20%</span>
      <i>BEST VALUE</i>
    </div>
  </div>

  <div class="vcr-offer__tiers">
    <div><span>02</span><p><b>Ritual Duo</b>10% OFF</p></div>
    <div><span>03</span><p><b>Ritual Trio</b>15% OFF</p></div>
    <div class="is-best"><span>4+</span><p><b>Complete Ritual</b>20% OFF</p></div>
    <div class="vcr-offer__auto"><span>✓</span><p><b>No code needed</b>Applied automatically</p></div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }}{
    background:#d4d2b4;
    margin:0!important;
    padding:0!important;
  }

  #shopify-section-{{ section.id }} .vcr-offer{
    position:relative;
    width:100%;
    margin:0!important;
    overflow:hidden;
    border:0;
    border-radius:0;
    color:#5a4632;
    background:#d4d2b4;
    box-shadow:none;
  }

  #shopify-section-{{ section.id }} .vcr-offer:before,
  #shopify-section-{{ section.id }} .vcr-offer:after,
  #shopify-section-{{ section.id }} .vcr-offer__ornament{
    display:none!important;
  }

  #shopify-section-{{ section.id }} .vcr-offer__inner{
    min-height:106px;
    padding:13px 64px 12px;
    display:grid;
    grid-template-columns:1.05fr 1fr .46fr;
    gap:30px;
    align-items:center;
    position:relative;
    z-index:1;
  }

  #shopify-section-{{ section.id }} .vcr-offer__intro{
    display:flex;
    flex-direction:column;
    justify-content:center;
  }

  #shopify-section-{{ section.id }} .vcr-offer__eyebrow,
  #shopify-section-{{ section.id }} .vcr-offer__label{
    display:inline-block;
    font-size:8px;
    font-weight:800;
    letter-spacing:.18em;
    text-transform:uppercase;
    color:#725a41;
  }

  #shopify-section-{{ section.id }} .vcr-offer__intro h2{
    max-width:520px;
    margin:3px 0 3px;
    font-size:clamp(20px,2vw,31px);
    line-height:1;
    letter-spacing:-.025em;
    color:#4b3929;
  }

  #shopify-section-{{ section.id }} .vcr-offer__intro p{
    max-width:600px;
    margin:0;
    color:#67513a;
    font-size:10px;
    line-height:1.35;
  }

  #shopify-section-{{ section.id }} .vcr-offer__hero{
    text-align:center;
    padding:4px 24px;
    border-left:1px solid rgba(90,70,50,.22);
    border-right:1px solid rgba(90,70,50,.22);
  }

  #shopify-section-{{ section.id }} .vcr-offer__hero strong{
    display:inline-block;
    margin:0 7px 0 0;
    font-family:Georgia,"Times New Roman",serif;
    font-weight:400;
    font-size:clamp(35px,3.5vw,52px);
    line-height:.9;
    color:#5a4632;
    vertical-align:middle;
  }

  #shopify-section-{{ section.id }} .vcr-offer__hero strong span{
    font-size:.54em;
    vertical-align:18%;
  }

  #shopify-section-{{ section.id }} .vcr-offer__hero p{
    display:inline-block;
    margin:0;
    font-size:10px;
    font-weight:800;
    letter-spacing:.12em;
    text-transform:uppercase;
    color:#5a4632;
    vertical-align:middle;
  }

  #shopify-section-{{ section.id }} .vcr-offer__hero a{
    display:flex;
    width:max-content;
    margin:6px auto 0;
    align-items:center;
    gap:8px;
    padding:7px 17px;
    border:1px solid #5a4632;
    border-radius:999px;
    background:#5a4632;
    color:#d4d2b4!important;
    text-decoration:none!important;
    font-size:8px;
    font-weight:800;
    letter-spacing:.13em;
    text-transform:uppercase;
    transition:.22s ease;
  }

  #shopify-section-{{ section.id }} .vcr-offer__hero a:hover{
    background:transparent;
    color:#5a4632!important;
    transform:translateY(-1px);
  }

  #shopify-section-{{ section.id }} .vcr-offer__seal{
    width:88px;
    height:88px;
    margin:auto;
    border:1px solid rgba(90,70,50,.42);
    border-radius:50%;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    background:rgba(255,255,255,.16);
    box-shadow:inset 0 0 0 4px rgba(255,255,255,.16);
    color:#5a4632;
  }

  #shopify-section-{{ section.id }} .vcr-offer__seal small{
    font-size:5px;
    font-weight:900;
    letter-spacing:.1em;
  }

  #shopify-section-{{ section.id }} .vcr-offer__seal b{
    margin:3px 0 0;
    font:400 17px/1 Georgia,"Times New Roman",serif;
    color:#5a4632;
  }

  #shopify-section-{{ section.id }} .vcr-offer__seal span{
    font:400 11px/1.15 Georgia,"Times New Roman",serif;
  }

  #shopify-section-{{ section.id }} .vcr-offer__seal i{
    margin-top:3px;
    padding:2px 5px;
    border-radius:999px;
    background:#5a4632;
    color:#d4d2b4;
    font-size:5px;
    font-style:normal;
    font-weight:900;
    letter-spacing:.07em;
  }

  #shopify-section-{{ section.id }} .vcr-offer__tiers{
    position:relative;
    z-index:1;
    display:grid;
    grid-template-columns:repeat(4,1fr);
    background:#5a4632;
    color:#d4d2b4;
  }

  #shopify-section-{{ section.id }} .vcr-offer__tiers>div{
    min-height:34px;
    padding:4px 18px;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:9px;
    border-right:1px solid rgba(212,210,180,.24);
  }

  #shopify-section-{{ section.id }} .vcr-offer__tiers>div:last-child{
    border-right:0;
  }

  #shopify-section-{{ section.id }} .vcr-offer__tiers span{
    width:22px;
    height:22px;
    border-radius:50%;
    display:grid;
    place-items:center;
    border:1px solid rgba(212,210,180,.55);
    font-size:7px;
    font-weight:900;
  }

  #shopify-section-{{ section.id }} .vcr-offer__tiers p{
    margin:0;
    font-size:7px;
    line-height:1.15;
    letter-spacing:.03em;
  }

  #shopify-section-{{ section.id }} .vcr-offer__tiers b{
    display:block;
    margin-bottom:1px;
    font-size:8px;
    color:#d4d2b4;
  }

  #shopify-section-{{ section.id }} .vcr-offer__tiers .is-best{
    background:#493826;
  }

  /* Remove vertical space between hero → offer → Most Loved */
  .template-index #shopify-section-vanaya_video + #shopify-section-vanaya_complete_ritual_offer,
  .template-index #shopify-section-vanaya_complete_ritual_offer + #shopify-section-vanaya_new{
    margin-top:0!important;
    margin-bottom:0!important;
    padding-top:0!important;
    padding-bottom:0!important;
  }

  .template-index #shopify-section-vanaya_complete_ritual_offer + #shopify-section-vanaya_new .vanaya-section{
    margin-top:0!important;
    padding-top:28px!important;
  }

  @media(max-width:900px){
    #shopify-section-{{ section.id }} .vcr-offer__inner{
      grid-template-columns:1fr 1fr;
      min-height:100px;
      padding:12px 28px 10px;
      gap:18px;
    }
    #shopify-section-{{ section.id }} .vcr-offer__seal{
      display:none;
    }
  }

  @media(max-width:650px){
    #shopify-section-{{ section.id }} .vcr-offer__inner{
      grid-template-columns:1fr;
      min-height:auto;
      padding:14px 18px 12px;
      gap:10px;
      text-align:center;
    }

    #shopify-section-{{ section.id }} .vcr-offer__intro p{
      display:none;
    }

    #shopify-section-{{ section.id }} .vcr-offer__hero{
      border:0;
      border-top:1px solid rgba(90,70,50,.22);
      padding:8px 0 0;
    }

    #shopify-section-{{ section.id }} .vcr-offer__tiers{
      grid-template-columns:repeat(4,1fr);
    }

    #shopify-section-{{ section.id }} .vcr-offer__tiers>div{
      min-height:38px;
      padding:4px 3px;
      gap:4px;
    }

    #shopify-section-{{ section.id }} .vcr-offer__tiers span{
      width:19px;height:19px;font-size:6px;
    }

    #shopify-section-{{ section.id }} .vcr-offer__tiers p{
      font-size:6px;
    }

    #shopify-section-{{ section.id }} .vcr-offer__tiers b{
      font-size:7px;
    }

    .template-index #shopify-section-vanaya_complete_ritual_offer + #shopify-section-vanaya_new .vanaya-section{
      padding-top:18px!important;
    }
  }
</style>

{% schema %}
{
  "name": "Complete Ritual Offer",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The More You Ritual, The More You Save"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build Your Ritual. Enjoy More."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Curate four or more Vanaya rituals and enjoy our highest automatic saving — thoughtfully designed to reward a more complete routine."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Shop link"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Button text",
      "default": "Build Your Ritual"
    }
  ],
  "presets": [
    {
      "name": "Complete Ritual Offer"
    }
  ]
}
{% endschema %}
