<section class="vanaya-section vanaya-bloggers" data-vanaya-bloggers>
  <div class="vanaya-heading">
    <div>
      <p class="vanaya-kicker">{{ section.settings.eyebrow }}</p>
      <h2>As Seen on <a class="vanaya-instagram-link" href="https://www.instagram.com/vanayaveda" target="_blank" rel="noopener noreferrer">@vanayaveda</a></h2>
    </div>
  </div>

  <div class="vanaya-blog-grid">
    {% assign legacy_sources = 'https://cdn.shopify.com/videos/c/o/v/5426c64ecf8d4133aec565ab4c7a835a.mp4|https://cdn.shopify.com/videos/c/o/v/a8bc644b3fc2426f865202dc5b64daf6.mp4|https://cdn.shopify.com/videos/c/o/v/e91a23ab717a47ed9a1e1f695289b5e8.mp4|https://cdn.shopify.com/videos/c/o/v/e4bde69316074a989c13395577e7de5d.mov' | split: '|' %}
    {% for block in section.blocks %}
      {% assign video_src = '' %}
      {% if block.settings.video != blank %}
        {% for source in block.settings.video.sources %}
          {% if source.mime_type == 'video/mp4' %}
            {% assign video_src = source.url %}
            {% break %}
          {% endif %}
        {% endfor %}
        {% if video_src == blank and block.settings.video.sources.first != blank %}
          {% assign video_src = block.settings.video.sources.first.url %}
        {% endif %}
      {% elsif block.settings.external_url != blank %}
        {% assign video_src = block.settings.external_url %}
      {% elsif block.settings.legacy_slot > 0 %}
        {% assign legacy_index = block.settings.legacy_slot | minus: 1 %}
        {% assign video_src = legacy_sources[legacy_index] %}
      {% endif %}

      {% if video_src != blank %}
        <article
          data-vanaya-video-card
          tabindex="0"
          role="button"
          aria-label="Play Vanaya creator video {{ forloop.index }} with sound"
          {{ block.shopify_attributes }}
        >
          <video
            class="vanaya-blog-preview-video"
            src="{{ video_src }}"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="Vanaya creator video {{ forloop.index }}"
          ></video>
          <span class="vanaya-blog-video-hint">▶ Play with sound</span>
        </article>
      {% endif %}
    {% endfor %}
  </div>

  <div class="vanaya-video-lightbox" data-vanaya-video-lightbox aria-hidden="true">
    <div class="vanaya-video-lightbox__dialog" role="dialog" aria-modal="true" aria-label="Vanaya creator video">
      <button type="button" class="vanaya-video-lightbox__close" data-vanaya-video-close aria-label="Close video"><span aria-hidden="true">×</span></button>
      <div data-vanaya-video-stage></div>
    </div>
  </div>
</section>

<script>
(() => {
  const root = document.currentScript.previousElementSibling;
  if (!root || !root.matches('[data-vanaya-bloggers]')) return;

  const lightbox = root.querySelector('[data-vanaya-video-lightbox]');
  const stage = root.querySelector('[data-vanaya-video-stage]');
  const close = root.querySelector('[data-vanaya-video-close]');
  const cards = root.querySelectorAll('[data-vanaya-video-card]');

  const closeModal = () => {
    const video = stage.querySelector('video');
    if (video) {
      video.pause();
      video.removeAttribute('src');
      video.load?.();
    }
    stage.innerHTML = '';
    lightbox.classList.remove('is-open');
    lightbox.setAttribute('aria-hidden', 'true');
    document.documentElement.style.overflow = '';
  };

  const openModal = (card) => {
    const sourceVideo = card.querySelector('video');
    if (!sourceVideo) return;

    const src = sourceVideo.currentSrc || sourceVideo.getAttribute('src');
    if (!src) return;

    const video = document.createElement('video');
    video.src = src;
    video.controls = true;
    video.autoplay = false;
    video.loop = false;
    video.muted = false;
    video.defaultMuted = false;
    video.volume = 1;
    video.playsInline = true;
    video.preload = 'auto';
    video.className = 'vanaya-blog-modal-video';

    stage.innerHTML = '';
    stage.appendChild(video);

    lightbox.classList.add('is-open');
    lightbox.setAttribute('aria-hidden', 'false');
    document.documentElement.style.overflow = 'hidden';

    video.currentTime = 0;
    video.muted = false;
    video.defaultMuted = false;
    video.volume = 1;

    const playPromise = video.play();
    if (playPromise && typeof playPromise.catch === 'function') {
      playPromise.catch(() => {
        video.controls = true;
      });
    }
  };

  cards.forEach((card) => {
    card.addEventListener('click', () => openModal(card));
    card.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        openModal(card);
      }
    });
  });

  close?.addEventListener('click', closeModal);
  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) closeModal();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && lightbox?.classList.contains('is-open')) closeModal();
  });
})();
</script>

{% schema %}
{
  "name": "Vanaya blogger videos",
  "max_blocks": 5,
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Seen in their rituals"},
    {"type":"text","id":"heading","label":"Heading","default":"Beauty Rituals by Creators"}
  ],
  "blocks": [
    {
      "type":"video",
      "name":"Blogger video",
      "settings":[
        {"type":"video","id":"video","label":"Shopify-hosted video"},
        {"type":"url","id":"external_url","label":"External video URL"},
        {"type":"range","id":"legacy_slot","label":"Use existing Vanaya video","min":0,"max":4,"step":1,"default":0,"info":"0 = none; 1–4 = existing videos from the previous homepage setup."}
      ]
    }
  ],
  "presets":[{"name":"Vanaya blogger videos"}]
}
{% endschema %}}
