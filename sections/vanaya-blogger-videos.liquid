<section class="vanaya-section vanaya-bloggers" data-vanaya-bloggers>
  <style>
    /* Desktop: 5 equal cards. */
    @media screen and (min-width: 901px) {
      #shopify-section-{{ section.id }} .vanaya-blog-grid {
        display: grid !important;
        grid-template-columns: repeat(5, minmax(0, 1fr)) !important;
        grid-auto-flow: row !important;
        width: 100% !important;
        max-width: 1500px !important;
        margin-left: auto !important;
        margin-right: auto !important;
        gap: 12px !important;
        align-items: start !important;
      }
      #shopify-section-{{ section.id }} .vanaya-blog-grid > article {
        width: 100% !important;
        min-width: 0 !important;
        max-width: none !important;
        flex: none !important;
        margin: 0 !important;
      }
    }

    /* Mobile creator rail: readable portrait videos instead of five tiny desktop cards. */
    @media screen and (max-width: 900px) {
      #shopify-section-{{ section.id }} .vanaya-bloggers{
        padding-left:0!important;
        padding-right:0!important;
        overflow:hidden;
      }
      #shopify-section-{{ section.id }} .vanaya-heading{
        padding-left:20px!important;
        padding-right:20px!important;
        margin-bottom:18px!important;
      }
      #shopify-section-{{ section.id }} .vanaya-heading h2{
        font-size:clamp(34px,9.8vw,48px)!important;
        line-height:1.02!important;
        letter-spacing:-.035em!important;
      }
      #shopify-section-{{ section.id }} .vanaya-blog-grid{
        display:flex!important;
        width:auto!important;
        max-width:none!important;
        gap:12px!important;
        margin:0!important;
        padding:0 20px 12px!important;
        overflow-x:auto!important;
        overflow-y:hidden!important;
        scroll-snap-type:x mandatory;
        scroll-padding-left:20px;
        -webkit-overflow-scrolling:touch;
        scrollbar-width:none;
      }
      #shopify-section-{{ section.id }} .vanaya-blog-grid::-webkit-scrollbar{display:none}
      #shopify-section-{{ section.id }} .vanaya-blog-grid > article{
        flex:0 0 min(58vw,235px)!important;
        width:min(58vw,235px)!important;
        min-width:min(58vw,235px)!important;
        max-width:min(58vw,235px)!important;
        margin:0!important;
        scroll-snap-align:start;
        border-radius:54px 54px 16px 16px!important;
      }
      #shopify-section-{{ section.id }} .vanaya-blog-video-hint{
        right:10px!important;
        bottom:10px!important;
        max-width:calc(100% - 20px);
        padding:8px 10px!important;
        font-size:9px!important;
        line-height:1.15!important;
      }
    }
    @media screen and (max-width: 480px) {
      #shopify-section-{{ section.id }} .vanaya-blog-grid > article{
        flex-basis:66vw!important;
        width:66vw!important;
        min-width:66vw!important;
        max-width:66vw!important;
      }
    }
  </style>
  <div class="vanaya-heading">
    <div>
      <p class="vanaya-kicker">{{ section.settings.eyebrow }}</p>
      <h2>As Seen on <a class="vanaya-instagram-link" href="https://www.instagram.com/vanayaveda" target="_blank" rel="noopener noreferrer">@vanayaveda</a></h2>
    </div>
  </div>

  <div class="vanaya-blog-grid">
    {% assign legacy_sources = 'https://cdn.shopify.com/videos/c/o/v/5426c64ecf8d4133aec565ab4c7a835a.mp4|https://cdn.shopify.com/videos/c/o/v/a8bc644b3fc2426f865202dc5b64daf6.mp4|https://cdn.shopify.com/videos/c/o/v/e91a23ab717a47ed9a1e1f695289b5e8.mp4|https://cdn.shopify.com/videos/c/o/v/e4bde69316074a989c13395577e7de5d.mov' | split: '|' %}
    {% for block in section.blocks %}
      {% assign video_src = '' %}
      {% if block.settings.video != blank %}
        {% for source in block.settings.video.sources %}
          {% if source.mime_type == 'video/mp4' %}
            {% assign video_src = source.url %}
            {% break %}
          {% endif %}
        {% endfor %}
        {% if video_src == blank and block.settings.video.sources.first != blank %}
          {% assign video_src = block.settings.video.sources.first.url %}
        {% endif %}
      {% elsif block.settings.external_url != blank %}
        {% assign video_src = block.settings.external_url %}
      {% elsif block.settings.legacy_slot > 0 %}
        {% assign legacy_index = block.settings.legacy_slot | minus: 1 %}
        {% assign video_src = legacy_sources[legacy_index] %}
      {% endif %}

      {% if video_src != blank %}
        <article
          data-vanaya-video-card
          tabindex="0"
          role="button"
          aria-label="Play Vanaya creator video {{ forloop.index }} with sound"
          {{ block.shopify_attributes }}
        >
          <video
            class="vanaya-blog-preview-video"
            src="{{ video_src }}"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="Vanaya creator video {{ forloop.index }}"
          ></video>
          <span class="vanaya-blog-video-hint">▶ Play with sound</span>
        </article>
      {% endif %}
    {% endfor %}
  </div>

  <div class="vanaya-video-lightbox" data-vanaya-video-lightbox aria-hidden="true">
    <div class="vanaya-video-lightbox__dialog" role="dialog" aria-modal="true" aria-label="Vanaya creator video">
      <button type="button" class="vanaya-video-lightbox__close" data-vanaya-video-close aria-label="Close video"><span aria-hidden="true">×</span></button>
      <div data-vanaya-video-stage></div>
    </div>
  </div>
</section>

<script>
(() => {
  const root = document.currentScript.previousElementSibling;
  if (!root || !root.matches('[data-vanaya-bloggers]')) return;

  const lightbox = root.querySelector('[data-vanaya-video-lightbox]');
  const stage = root.querySelector('[data-vanaya-video-stage]');
  const close = root.querySelector('[data-vanaya-video-close]');
  const cards = root.querySelectorAll('[data-vanaya-video-card]');

  const closeModal = () => {
    const video = stage.querySelector('video');
    if (video) {
      video.pause();
      video.removeAttribute('src');
      video.load?.();
    }
    stage.innerHTML = '';
    lightbox.classList.remove('is-open');
    lightbox.setAttribute('aria-hidden', 'true');
    document.documentElement.style.overflow = '';
  };

  const openModal = (card) => {
    const sourceVideo = card.querySelector('video');
    if (!sourceVideo) return;

    const src = sourceVideo.currentSrc || sourceVideo.getAttribute('src');
    if (!src) return;

    const video = document.createElement('video');
    video.src = src;
    video.controls = true;
    video.autoplay = false;
    video.loop = false;
    video.muted = false;
    video.defaultMuted = false;
    video.volume = 1;
    video.playsInline = true;
    video.preload = 'auto';
    video.className = 'vanaya-blog-modal-video';

    stage.innerHTML = '';
    stage.appendChild(video);

    lightbox.classList.add('is-open');
    lightbox.setAttribute('aria-hidden', 'false');
    document.documentElement.style.overflow = 'hidden';

    video.currentTime = 0;
    video.muted = false;
    video.defaultMuted = false;
    video.volume = 1;

    const playPromise = video.play();
    if (playPromise && typeof playPromise.catch === 'function') {
      playPromise.catch(() => {
        video.controls = true;
      });
    }
  };

  cards.forEach((card) => {
    card.addEventListener('click', () => openModal(card));
    card.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        openModal(card);
      }
    });
  });

  close?.addEventListener('click', closeModal);
  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) closeModal();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && lightbox?.classList.contains('is-open')) closeModal();
  });
})();
</script>

{% schema %}
{
  "name": "Vanaya blogger videos",
  "max_blocks": 5,
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Seen in their rituals"},
    {"type":"text","id":"heading","label":"Heading","default":"Beauty Rituals by Creators"}
  ],
  "blocks": [
    {
      "type":"video",
      "name":"Blogger video",
      "settings":[
        {"type":"video","id":"video","label":"Shopify-hosted video"},
        {"type":"url","id":"external_url","label":"External video URL"},
        {"type":"range","id":"legacy_slot","label":"Use existing Vanaya video","min":0,"max":4,"step":1,"default":0,"info":"0 = none; 1–4 = existing videos from the previous homepage setup."}
      ]
    }
  ],
  "presets":[{"name":"Vanaya blogger videos"}]
}
{% endschema %}
