<section class="vanaya-section vanaya-bloggers" data-vanaya-bloggers>
  <style>
    #shopify-section-{{ section.id }} .vanaya-blogger-shell{
      position:relative;
      max-width:1480px;
      margin:0 auto;
    }
    #shopify-section-{{ section.id }} .vanaya-blog-grid{
      display:flex!important;
      gap:14px!important;
      width:100%!important;
      max-width:none!important;
      margin:0!important;
      padding:0!important;
      overflow-x:auto!important;
      overflow-y:hidden!important;
      scroll-snap-type:x mandatory;
      scroll-behavior:smooth;
      scrollbar-width:none;
      -webkit-overflow-scrolling:touch;
    }
    #shopify-section-{{ section.id }} .vanaya-blog-grid::-webkit-scrollbar{display:none}
    #shopify-section-{{ section.id }} .vanaya-blog-grid > article{
      position:relative;
      flex:0 0 calc((100% - 42px)/4)!important;
      width:calc((100% - 42px)/4)!important;
      min-width:0!important;
      max-width:none!important;
      margin:0!important;
      scroll-snap-align:start;
      aspect-ratio:9/16;
      overflow:hidden;
      border-radius:46px 46px 16px 16px!important;
    }
    #shopify-section-{{ section.id }} .vanaya-blog-grid video{
      display:block;
      width:100%;
      height:100%;
      object-fit:cover;
    }
    #shopify-section-{{ section.id }} .vanaya-blogger-arrow{
      position:absolute;
      z-index:8;
      top:50%;
      display:grid;
      place-items:center;
      width:28px;
      height:28px;
      padding:0;
      transform:translateY(-50%);
      border:1px solid rgba(65,56,45,.32);
      border-radius:50%;
      background:rgba(255,250,240,.92);
      color:#41382d;
      font:500 18px/1 Arial,sans-serif;
      cursor:pointer;
      box-shadow:0 4px 12px rgba(45,38,30,.08);
    }
    #shopify-section-{{ section.id }} .vanaya-blogger-arrow--prev{left:-14px}
    #shopify-section-{{ section.id }} .vanaya-blogger-arrow--next{right:-14px}

    @media screen and (max-width:900px){
      #shopify-section-{{ section.id }} .vanaya-bloggers{
        padding-left:0!important;
        padding-right:0!important;
        overflow:hidden;
      }
      #shopify-section-{{ section.id }} .vanaya-heading{
        padding-left:20px!important;
        padding-right:20px!important;
        margin-bottom:18px!important;
      }
      #shopify-section-{{ section.id }} .vanaya-heading h2{
        font-size:clamp(34px,9.8vw,48px)!important;
        line-height:1.02!important;
        letter-spacing:-.035em!important;
      }
      #shopify-section-{{ section.id }} .vanaya-blogger-shell{
        max-width:none;
        margin:0;
      }
      #shopify-section-{{ section.id }} .vanaya-blog-grid{
        gap:12px!important;
        padding:0 20px 12px!important;
        scroll-padding-left:20px;
      }
      #shopify-section-{{ section.id }} .vanaya-blog-grid > article{
        flex:0 0 78vw!important;
        width:78vw!important;
        min-width:78vw!important;
        max-width:78vw!important;
        border-radius:54px 54px 16px 16px!important;
      }
      #shopify-section-{{ section.id }} .vanaya-blogger-arrow{
        display:none!important;
      }
    }
    @media screen and (max-width:480px){
      #shopify-section-{{ section.id }} .vanaya-blog-grid > article{
        flex-basis:80vw!important;
        width:80vw!important;
        min-width:80vw!important;
        max-width:80vw!important;
      }
    }
  </style>
  <div class="vanaya-heading">
    <div>
      <p class="vanaya-kicker">{{ section.settings.eyebrow }}</p>
      <h2>As Seen on <a class="vanaya-instagram-link" href="https://www.instagram.com/vanayaveda" target="_blank" rel="noopener noreferrer">@vanayaveda</a></h2>
    </div>
  </div>

  <div class="vanaya-blogger-shell">
    <button type="button" class="vanaya-blogger-arrow vanaya-blogger-arrow--prev" data-blogger-prev aria-label="Previous video">‹</button>
    <div class="vanaya-blog-grid" data-blogger-track>
    {% assign legacy_sources = 'https://cdn.shopify.com/videos/c/o/v/5426c64ecf8d4133aec565ab4c7a835a.mp4|https://cdn.shopify.com/videos/c/o/v/a8bc644b3fc2426f865202dc5b64daf6.mp4|https://cdn.shopify.com/videos/c/o/v/e91a23ab717a47ed9a1e1f695289b5e8.mp4|https://cdn.shopify.com/videos/c/o/v/e4bde69316074a989c13395577e7de5d.mov' | split: '|' %}
    {% for block in section.blocks %}
      {% assign video_src = '' %}
      {% if block.settings.video != blank %}
        {% for source in block.settings.video.sources %}
          {% if source.mime_type == 'video/mp4' %}
            {% assign video_src = source.url %}
            {% break %}
          {% endif %}
        {% endfor %}
        {% if video_src == blank and block.settings.video.sources.first != blank %}
          {% assign video_src = block.settings.video.sources.first.url %}
        {% endif %}
      {% elsif block.settings.external_url != blank %}
        {% assign video_src = block.settings.external_url %}
      {% elsif block.settings.legacy_slot > 0 %}
        {% assign legacy_index = block.settings.legacy_slot | minus: 1 %}
        {% assign video_src = legacy_sources[legacy_index] %}
      {% endif %}

      {% if video_src != blank %}
        <article
          data-vanaya-video-card
          tabindex="0"
          role="button"
          aria-label="View Vanaya creator video {{ forloop.index }}"
          {{ block.shopify_attributes }}
        >
          <video
            class="vanaya-blog-preview-video"
            src="{{ video_src }}"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="Vanaya creator video {{ forloop.index }}"
          ></video>
        </article>
      {% endif %}
    {% endfor %}
    </div>
    <button type="button" class="vanaya-blogger-arrow vanaya-blogger-arrow--next" data-blogger-next aria-label="Next video">›</button>
  </div>

  <div class="vanaya-video-lightbox" data-vanaya-video-lightbox aria-hidden="true">
    <div class="vanaya-video-lightbox__dialog" role="dialog" aria-modal="true" aria-label="Vanaya creator video">
      <button type="button" class="vanaya-video-lightbox__close" data-vanaya-video-close aria-label="Close video"><span aria-hidden="true">×</span></button>
      <div data-vanaya-video-stage></div>
    </div>
  </div>
</section>


<style id="vanaya-blogger-desktop-carousel-fix">
@media(min-width:901px){
  #shopify-section-{{ section.id }} .vanaya-blogger-shell{
    position:relative!important;
    max-width:1380px!important;
    margin:0 auto!important;
    padding:0 16px!important;
    overflow:hidden!important;
  }
  #shopify-section-{{ section.id }} .vanaya-blog-grid{
    display:flex!important;
    gap:14px!important;
    width:calc(125% + 3.5px)!important;
    max-width:none!important;
    padding:0!important;
    margin:0!important;
    overflow:visible!important;
    scroll-snap-type:none!important;
    scroll-behavior:auto!important;
    transition:transform .6s cubic-bezier(.22,.7,.18,1)!important;
    will-change:transform;
  }
  #shopify-section-{{ section.id }} .vanaya-blog-grid>article{
    flex:0 0 calc((80% - 42px)/4)!important;
    width:calc((80% - 42px)/4)!important;
    min-width:calc((80% - 42px)/4)!important;
    max-width:calc((80% - 42px)/4)!important;
  }
  #shopify-section-{{ section.id }} .vanaya-blogger-arrow{
    display:grid!important;
    z-index:20!important;
    top:50%!important;
    width:18px!important;
    min-width:18px!important;
    max-width:18px!important;
    height:18px!important;
    min-height:18px!important;
    max-height:18px!important;
    padding:0!important;
    border:1px solid rgba(65,56,45,.38)!important;
    border-radius:50%!important;
    background:#fffaf0!important;
    color:#41382d!important;
    font:700 11px/1 Arial,sans-serif!important;
    box-shadow:none!important;
  }
  #shopify-section-{{ section.id }} .vanaya-blogger-arrow--prev{left:3px!important}
  #shopify-section-{{ section.id }} .vanaya-blogger-arrow--next{right:3px!important}
}
</style>

<script>
(() => {
  const root = document.currentScript.previousElementSibling;
  if (!root || !root.matches('[data-vanaya-bloggers]')) return;

  const lightbox = root.querySelector('[data-vanaya-video-lightbox]');
  const stage = root.querySelector('[data-vanaya-video-stage]');
  const close = root.querySelector('[data-vanaya-video-close]');
  const cards = root.querySelectorAll('[data-vanaya-video-card]');

  const track = root.querySelector('[data-blogger-track]');
  const prevButton = root.querySelector('[data-blogger-prev]');
  const nextButton = root.querySelector('[data-blogger-next]');
  let carouselIndex = 0;
  let carouselTimer = null;

  const isMobile = () => window.innerWidth <= 900;
  const visibleCards = () => isMobile() ? 1 : 4;
  const maxCarouselIndex = () => Math.max(0, cards.length - visibleCards());

  const desktopStep = () => {
    if (cards.length < 2) return 0;
    const first = cards[0].getBoundingClientRect();
    const second = cards[1].getBoundingClientRect();
    return second.left - first.left;
  };

  const goToCarouselIndex = (nextIndex) => {
    if (!track || !cards.length) return;
    const max = maxCarouselIndex();
    carouselIndex = nextIndex > max ? 0 : nextIndex < 0 ? max : nextIndex;

    if (isMobile()) {
      track.style.transform = '';
      const card = cards[carouselIndex];
      if (card) track.scrollTo({ left: card.offsetLeft - 20, behavior: 'smooth' });
    } else {
      track.scrollLeft = 0;
      track.style.transform = 'translate3d(-' + (carouselIndex * desktopStep()) + 'px,0,0)';
    }
  };

  const restartCarousel = () => {
    clearInterval(carouselTimer);
    if (cards.length <= visibleCards()) return;
    carouselTimer = setInterval(() => goToCarouselIndex(carouselIndex + 1), 4200);
  };

  prevButton?.addEventListener('click', () => { goToCarouselIndex(carouselIndex - 1); restartCarousel(); });
  nextButton?.addEventListener('click', () => { goToCarouselIndex(carouselIndex + 1); restartCarousel(); });
  track?.addEventListener('mouseenter', () => { if (!isMobile()) clearInterval(carouselTimer); });
  track?.addEventListener('mouseleave', () => { if (!isMobile()) restartCarousel(); });
  track?.addEventListener('touchstart', () => { if (isMobile()) clearInterval(carouselTimer); }, {passive:true});
  track?.addEventListener('touchend', () => { if (isMobile()) restartCarousel(); }, {passive:true});
  window.addEventListener('resize', () => {
    carouselIndex = 0;
    track.style.transform = '';
    goToCarouselIndex(0);
    restartCarousel();
  }, {passive:true});
  goToCarouselIndex(0);
  restartCarousel();


  const closeModal = () => {
    const video = stage.querySelector('video');
    if (video) {
      video.pause();
      video.removeAttribute('src');
      video.load?.();
    }
    stage.innerHTML = '';
    lightbox.classList.remove('is-open');
    lightbox.setAttribute('aria-hidden', 'true');
    document.documentElement.style.overflow = '';
  };

  const openModal = (card) => {
    const sourceVideo = card.querySelector('video');
    if (!sourceVideo) return;

    const src = sourceVideo.currentSrc || sourceVideo.getAttribute('src');
    if (!src) return;

    const video = document.createElement('video');
    video.src = src;
    video.controls = true;
    video.autoplay = false;
    video.loop = false;
    video.muted = false;
    video.defaultMuted = false;
    video.volume = 1;
    video.playsInline = true;
    video.preload = 'auto';
    video.className = 'vanaya-blog-modal-video';

    stage.innerHTML = '';
    stage.appendChild(video);

    lightbox.classList.add('is-open');
    lightbox.setAttribute('aria-hidden', 'false');
    document.documentElement.style.overflow = 'hidden';

    video.currentTime = 0;
    video.muted = false;
    video.defaultMuted = false;
    video.volume = 1;

    const playPromise = video.play();
    if (playPromise && typeof playPromise.catch === 'function') {
      playPromise.catch(() => {
        video.controls = true;
      });
    }
  };

  cards.forEach((card) => {
    card.addEventListener('click', () => openModal(card));
    card.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        openModal(card);
      }
    });
  });

  close?.addEventListener('click', closeModal);
  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) closeModal();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && lightbox?.classList.contains('is-open')) closeModal();
  });
})();
</script>

{% schema %}
{
  "name": "Vanaya blogger videos",
  "max_blocks": 5,
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Seen in their rituals"},
    {"type":"text","id":"heading","label":"Heading","default":"Beauty Rituals by Creators"}
  ],
  "blocks": [
    {
      "type":"video",
      "name":"Blogger video",
      "settings":[
        {"type":"video","id":"video","label":"Shopify-hosted video"},
        {"type":"url","id":"external_url","label":"External video URL"},
        {"type":"range","id":"legacy_slot","label":"Use existing Vanaya video","min":0,"max":4,"step":1,"default":0,"info":"0 = none; 1–4 = existing videos from the previous homepage setup."}
      ]
    }
  ],
  "presets":[{"name":"Vanaya blogger videos"}]
}
{% endschema %}
