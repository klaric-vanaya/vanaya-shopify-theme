],"blocks":[{"type":"video","name":"Blogger video","settings":[{"type":"video","id":"video","label":"Shopify-hosted video"},{"type":"text","id":"fallback_asset","label":"Included asset filename"}]}],"presets":[{"name":"Vanaya blogger videos"}]}
{% endschema %}
