<section class="vanaya-section vanaya-seabuckthorn" id="our-story">
  <div class="vanaya-seabuckthorn__inner">
    <div class="vanaya-seabuckthorn__visual">
      <div class="vanaya-seabuckthorn__frame">
        {% if section.settings.video != blank %}
          {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
        {% else %}
          <video src="{{ section.settings.fallback_video | asset_url }}" autoplay muted loop playsinline preload="metadata"></video>
        {% endif %}
      </div>
      <div class="vanaya-seabuckthorn__seal" aria-hidden="true"><span>RARE INGREDIENTS</span><small>FROM LADAKH</small></div>
    </div>

    <div class="vanaya-seabuckthorn__content">
      <p class="vanaya-kicker">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <p class="vanaya-seabuckthorn__lead">{{ section.settings.text }}</p>

      <div class="vanaya-seabuckthorn__benefits">
        <article><span>01</span><div><h3>Replenishes the skin barrier</h3><p>Helps support dry, depleted skin with a naturally nourishing lipid profile.</p></div></article>
        <article><span>02</span><div><h3>Restores supple radiance</h3><p>Promotes softer-looking skin and revives the appearance of everyday dullness.</p></div></article>
        <article><span>03</span><div><h3>Supports visible elasticity</h3><p>A vitamin-rich ritual created for skin that feels less resilient or looks fatigued.</p></div></article>
        <article><span>04</span><div><h3>One ritual, many concerns</h3><p>A few considered drops bring nourishment, comfort and glow into one elegant step.</p></div></article>
      </div>

      <a class="vanaya-cta" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_text }}</a>
    </div>
  </div>
</section>

<style>
.vanaya-seabuckthorn{padding:120px max(24px,5vw);overflow:hidden;background:linear-gradient(135deg,#e9e7cf 0%,#f8f2e4 55%,#e5dfc5 100%);color:#2e291f}.vanaya-seabuckthorn__inner{display:grid;grid-template-columns:minmax(340px,.78fr) minmax(520px,1.22fr);gap:clamp(64px,8vw,138px);max-width:1460px;margin:auto;align-items:center}.vanaya-seabuckthorn__visual{position:relative;display:flex;justify-content:center}.vanaya-seabuckthorn__frame{position:relative;width:min(100%,520px);aspect-ratio:9/15.3;border:1px solid rgba(54,48,34,.22);border-radius:180px 180px 8px 8px;padding:12px;background:#d4d2b4;box-shadow:0 36px 80px rgba(60,55,38,.2)}.vanaya-seabuckthorn__frame:after{content:"";position:absolute;z-index:2;inset:24px;border:1px solid rgba(255,255,255,.6);border-radius:150px 150px 3px 3px;pointer-events:none}.vanaya-seabuckthorn__frame video{display:block;width:100%;height:100%;border-radius:166px 166px 4px 4px;object-fit:cover;background:#aaa783}.vanaya-seabuckthorn__film-label{position:absolute;z-index:3;left:50%;bottom:34px;transform:translateX(-50%);width:max-content;max-width:78%;padding:11px 18px;background:rgba(255,250,240,.88);color:#41382d;font:800 9px/1.2 Arial,sans-serif;letter-spacing:.17em;text-transform:uppercase;backdrop-filter:blur(8px)}.vanaya-seabuckthorn__seal{position:absolute;z-index:4;right:-28px;bottom:9%;display:grid;place-items:center;width:126px;height:126px;border:1px solid rgba(255,255,255,.75);border-radius:50%;background:#6f7656;color:#fff;text-align:center;box-shadow:0 16px 34px rgba(49,54,37,.22)}.vanaya-seabuckthorn__seal:before{content:"";position:absolute;inset:7px;border:1px solid rgba(255,255,255,.42);border-radius:50%}.vanaya-seabuckthorn__seal span{font:17px/.9 Georgia,"Times New Roman",serif;letter-spacing:.06em}.vanaya-seabuckthorn__seal small{position:absolute;bottom:23px;font:700 7px Arial,sans-serif;letter-spacing:.22em}.vanaya-seabuckthorn__content h2{max-width:760px;margin:12px 0 26px;color:#332b20;font:clamp(48px,5.1vw,82px)/.98 Georgia,"Times New Roman",serif;letter-spacing:-.045em}.vanaya-seabuckthorn__lead{max-width:690px;margin:0 0 36px;color:#5c5245;font:18px/1.75 Georgia,"Times New Roman",serif}.vanaya-seabuckthorn__benefits{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid rgba(46,41,31,.17);border-left:1px solid rgba(46,41,31,.17)}.vanaya-seabuckthorn__benefits article{display:grid;grid-template-columns:36px 1fr;gap:15px;min-height:152px;padding:25px 22px;border-right:1px solid rgba(46,41,31,.17);border-bottom:1px solid rgba(46,41,31,.17);background:rgba(255,250,240,.33)}.vanaya-seabuckthorn__benefits article>span{color:#8a7049;font:700 10px Arial,sans-serif;letter-spacing:.12em}.vanaya-seabuckthorn__benefits h3{margin:0 0 9px;color:#363024;font:22px/1.08 Georgia,"Times New Roman",serif}.vanaya-seabuckthorn__benefits p{margin:0;color:#6a6051;font:14px/1.55 Georgia,"Times New Roman",serif}.vanaya-seabuckthorn__compare{margin:25px 0 28px;border:1px solid rgba(46,41,31,.18);background:#fffaf0}.vanaya-seabuckthorn__compare>p{margin:0;padding:12px 17px;border-bottom:1px solid rgba(46,41,31,.13);color:#756243;font:800 9px Arial,sans-serif;letter-spacing:.18em;text-transform:uppercase}.vanaya-seabuckthorn__compare>div{display:grid;grid-template-columns:190px 1fr;gap:16px;padding:14px 17px;color:#746b5d;font:12px/1.45 Arial,sans-serif}.vanaya-seabuckthorn__compare>div+div{border-top:1px solid rgba(46,41,31,.1)}.vanaya-seabuckthorn__compare span{font-weight:800}.vanaya-seabuckthorn__compare strong{font-weight:500}.vanaya-seabuckthorn__compare .is-vanaya{background:#d4d2b4;color:#323728}.vanaya-seabuckthorn__content .vanaya-cta{display:inline-flex;align-items:center;min-height:50px;padding:0 25px;border:1px solid #2e291f;background:#2e291f;color:#fff;font:800 10px Arial,sans-serif;letter-spacing:.14em;text-decoration:none;text-transform:uppercase;transition:.3s}.vanaya-seabuckthorn__content .vanaya-cta:hover{background:#6f7656;border-color:#6f7656;transform:translateY(-2px)}.vanaya-seabuckthorn__note{display:inline-block;margin:0 0 0 18px;color:#82796a;font:10px/1.45 Arial,sans-serif;vertical-align:middle}@media(max-width:980px){.vanaya-seabuckthorn__inner{grid-template-columns:minmax(280px,.8fr) minmax(400px,1.2fr);gap:48px}.vanaya-seabuckthorn__benefits{grid-template-columns:1fr}.vanaya-seabuckthorn__benefits article{min-height:125px}.vanaya-seabuckthorn__seal{right:-18px;width:106px;height:106px}.vanaya-seabuckthorn__seal small{bottom:18px}}@media(max-width:760px){.vanaya-seabuckthorn{padding:72px 14px}.vanaya-seabuckthorn__inner{grid-template-columns:1fr;gap:55px}.vanaya-seabuckthorn__frame{width:min(88vw,440px)}.vanaya-seabuckthorn__seal{right:0}.vanaya-seabuckthorn__content h2{font-size:clamp(44px,13vw,66px)}.vanaya-seabuckthorn__lead{font-size:16px}.vanaya-seabuckthorn__benefits article{grid-template-columns:30px 1fr;padding:22px 15px}.vanaya-seabuckthorn__compare>div{grid-template-columns:1fr;gap:5px}.vanaya-seabuckthorn__note{display:block;margin:14px 0 0}}
</style>

{% schema %}
{"name":"Sea Buckthorn feature","settings":[
{"type":"video","id":"video","label":"Shopify-hosted vertical video"},
{"type":"text","id":"fallback_video","label":"Included video filename","default":"vanaya-sea-buckthorn-film.mp4"},
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The Vanaya philosophy · Sea Buckthorn"},
{"type":"text","id":"heading","label":"Heading","default":"A golden ritual for resilient, luminous skin"},
{"type":"textarea","id":"text","label":"Introduction","default":"Vanaya Sea Buckthorn Oil is a concentrated, vitamin-rich ritual for skin that feels dry, depleted or less elastic. A few considered drops help replenish comfort, revive visible radiance and support a healthier-looking skin barrier."},
{"type":"url","id":"link","label":"Product link"},
{"type":"text","id":"link_text","label":"Link text","default":"Discover Sea Buckthorn Oil"}
],"presets":[{"name":"Sea Buckthorn feature"}]}
{% endschema %}
