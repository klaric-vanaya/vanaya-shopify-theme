{% liquid
  assign source_collection = section.settings.collection
  if source_collection == blank
    assign source_collection = collections['all']
  endif
%}
<section class="vanaya-section vanaya-explore-collection" id="{{ section.settings.anchor | default: 'explore-the-range' | handle }}" data-vanaya-explore-collection data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.autoplay_speed }}">
  <div class="vanaya-explore-collection__head">
    {% if section.settings.eyebrow != blank %}<p class="vanaya-kicker">{{ section.settings.eyebrow }}</p>{% endif %}
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.subheading != blank %}<p class="vanaya-explore-collection__subheading">{{ section.settings.subheading }}</p>{% endif %}
  </div>
  {% if source_collection != blank and source_collection.products_count > 0 %}
  <div class="vanaya-explore-collection__shell">
    <button type="button" class="vanaya-explore-collection__arrow vanaya-explore-collection__arrow--prev" data-explore-prev aria-label="Previous product"><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"/></svg></button>
    <div class="vanaya-explore-collection__window">
      <div class="vanaya-explore-collection__track" data-explore-track>
        {% for product in source_collection.products %}
        <article class="vanaya-explore-collection__card" data-explore-card>
          <button type="button" class="vanaya-explore-collection__heart v29-wishlist-btn" data-v29-wishlist data-handle="{{ product.handle }}" data-title="{{ product.title | escape }}" data-url="{{ product.url }}" data-image="{{ product.featured_image | image_url: width: 900 }}" data-price="{{ product.price | money | escape }}" data-variant-id="{{ product.selected_or_first_available_variant.id }}" aria-label="Save {{ product.title | escape }} to wishlist" aria-pressed="false">♡</button>
          <a class="vanaya-explore-collection__media" href="{{ product.url }}">
            {% if product.media[0] != blank %}
              {{ product.media[0].preview_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,800,1000,1200', class: 'vanaya-explore-collection__image vanaya-explore-collection__image--primary', alt: product.title }}
            {% elsif product.featured_image != blank %}
              {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,800,1000,1200', class: 'vanaya-explore-collection__image vanaya-explore-collection__image--primary', alt: product.title }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'vanaya-explore-collection__image vanaya-explore-collection__image--primary' }}
            {% endif %}
            {% if product.media.size > 1 and product.media[1].preview_image != blank %}
              {{ product.media[1].preview_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,800,1000,1200', class: 'vanaya-explore-collection__image vanaya-explore-collection__image--secondary', alt: product.title }}
            {% endif %}
          </a>
          <div class="vanaya-explore-collection__copy">
            {% if product.vendor != blank and section.settings.show_vendor %}<p class="vanaya-explore-collection__vendor">{{ product.vendor }}</p>{% endif %}
            <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
            <p class="vanaya-explore-collection__price">{% if product.compare_at_price_max > product.price %}<span class="vanaya-explore-collection__compare">{{ product.compare_at_price_max | money }}</span>{% endif %}<span>{{ product.price | money }}</span></p>
            <button
              class="vanaya-explore-collection__add vanaya-button-v20"
              type="button"
              data-vanaya-quick-add
              data-variant-id="{{ product.selected_or_first_available_variant.id }}"
              data-product-url="{{ product.url }}"
              {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
            >{% if product.selected_or_first_available_variant.available %}Add to Bag{% else %}Sold Out{% endif %}</button>
          </div>
        </article>
        {% endfor %}
      </div>
    </div>
    <button type="button" class="vanaya-explore-collection__arrow vanaya-explore-collection__arrow--next" data-explore-next aria-label="Next product"><svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg></button>
  </div>
  {% else %}
  <div class="vanaya-explore-collection__empty"><p>Select a Shopify collection in the Theme Editor to populate Explore the Range.</p></div>
  {% endif %}
</section>
<style>
  .template-index #root .vanaya-explore-collection .vanaya-explore-collection__add{
    -webkit-appearance:none!important;
    appearance:none!important;
    display:flex!important;
    align-items:center!important;
    justify-content:center!important;
    width:100%!important;
    min-height:42px!important;
    margin:15px 0 0!important;
    padding:8px 14px!important;
    border:1px solid #4b4136!important;
    border-radius:999px!important;
    background:#d4d2b4!important;
    color:#4b4136!important;
    box-shadow:none!important;
    cursor:pointer!important;
    font:800 10px/1.2 "Avenir Next",Avenir,Arial,sans-serif!important;
    letter-spacing:.09em!important;
    text-transform:uppercase!important;
  }
  .template-index #root .vanaya-explore-collection .vanaya-explore-collection__add::before,
  .template-index #root .vanaya-explore-collection .vanaya-explore-collection__add::after{
    content:none!important;
    display:none!important;
  }
  .template-index #root .vanaya-explore-collection .vanaya-explore-collection__add:hover,
  .template-index #root .vanaya-explore-collection .vanaya-explore-collection__add:focus-visible{
    background:#c5c29f!important;
    transform:translateY(-1px);
  }
  .template-index #root .vanaya-explore-collection .vanaya-explore-collection__add:disabled{
    cursor:not-allowed!important;
    opacity:.55!important;
    transform:none!important;
  }
  @media(max-width:760px){
    .template-index #root .vanaya-explore-collection .vanaya-explore-collection__add{
      min-height:38px!important;
      margin-top:11px!important;
      padding:7px 6px!important;
      font-size:8px!important;
    }
  }
</style>
<script>
(() => {
  const root = document.getElementById('{{ section.settings.anchor | default: 'explore-the-range' | handle }}');
  if (!root || !root.matches('[data-vanaya-explore-collection]')) return;

  const track = root.querySelector('[data-explore-track]');
  const cards = track ? Array.from(track.querySelectorAll('[data-explore-card]')) : [];
  const prev = root.querySelector('[data-explore-prev]');
  const next = root.querySelector('[data-explore-next]');
  if (!track || !cards.length) return;

  let index = 0;
  let timer = null;
  const visible = () => window.innerWidth <= 760 ? 2 : 4;
  const maxIndex = () => Math.max(0, cards.length - visible());
  const step = () => {
    const styles = getComputedStyle(track);
    const gap = parseFloat(styles.gap || styles.columnGap) || 0;
    return cards[0].getBoundingClientRect().width + gap;
  };
  const render = () => {
    index = Math.max(0, Math.min(index, maxIndex()));
    track.style.transform = `translate3d(${-index * step()}px,0,0)`;
  };
  const move = (direction) => {
    const max = maxIndex();
    if (max <= 0) return;
    index = direction > 0 ? (index >= max ? 0 : index + 1) : (index <= 0 ? max : index - 1);
    render();
  };
  const restart = () => {
    clearInterval(timer);
    if (root.dataset.autoplay !== 'true' || maxIndex() <= 0) return;
    const seconds = Math.max(3, Number(root.dataset.speed || 5));
    timer = setInterval(() => move(1), seconds * 1000);
  };

  prev?.addEventListener('click', () => { move(-1); restart(); });
  next?.addEventListener('click', () => { move(1); restart(); });

  let startX = null;
  root.addEventListener('touchstart', (e) => {
    startX = e.touches[0]?.clientX ?? null;
  }, {passive:true});
  root.addEventListener('touchend', (e) => {
    if (startX === null) return;
    const endX = e.changedTouches[0]?.clientX ?? startX;
    const delta = endX - startX;
    if (Math.abs(delta) > 45) move(delta < 0 ? 1 : -1);
    startX = null;
    restart();
  }, {passive:true});

  root.addEventListener('mouseenter', () => clearInterval(timer));
  root.addEventListener('mouseleave', restart);
  window.addEventListener('resize', render, {passive:true});

  render();
  restart();
})();

if (!window.VanayaQuickAddV23) {
  window.VanayaQuickAddV23 = true;
  document.addEventListener('click', async function(event) {
    var button = event.target.closest('[data-vanaya-quick-add]');
    if (!button || button.disabled) return;
    event.preventDefault();
    event.stopPropagation();

    var variantId = Number(button.dataset.variantId || 0);
    if (!variantId) {
      if (button.dataset.productUrl) window.location.href = button.dataset.productUrl;
      return;
    }

    var originalText = button.textContent;
    button.disabled = true;
    button.textContent = 'Adding…';

    try {
      var response = await fetch('{{ routes.cart_add_url }}.js', {
        method: 'POST',
        credentials: 'same-origin',
        headers: {'Content-Type':'application/json','Accept':'application/json'},
        body: JSON.stringify({items:[{id:variantId,quantity:1}]})
      });
      if (!response.ok) throw new Error('Unable to add product');

      var cartResponse = await fetch('{{ routes.cart_url }}.js', {credentials:'same-origin'});
      if (cartResponse.ok) {
        var cart = await cartResponse.json();
        document.querySelectorAll('#cart-count, #cart-count--m').forEach(function(count) {
          count.textContent = cart.item_count;
        });
      }

      button.textContent = 'Added ✓';
      setTimeout(function() {
        button.disabled = false;
        button.textContent = originalText;
      }, 1500);
    } catch (error) {
      button.disabled = false;
      button.textContent = originalText;
      if (button.dataset.productUrl) window.location.href = button.dataset.productUrl;
    }
  });
}
</script>
{% schema %}
{
  "name":"Explore the Range",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Explore the Range"},
    {"type":"text","id":"heading","label":"Heading","default":"Explore the Range"},
    {"type":"text","id":"subheading","label":"Subheading","default":"Ayurvedic rituals, thoughtfully made for contemporary skin."},
    {"type":"collection","id":"collection","label":"Shopify collection","info":"If left blank, Shopify's All products collection is used."},
    {"type":"checkbox","id":"show_vendor","label":"Show vendor","default":false},
    {"type":"checkbox","id":"autoplay","label":"Auto-scroll","default":true},
    {"type":"range","id":"autoplay_speed","label":"Auto-scroll interval","min":3,"max":10,"step":1,"unit":"s","default":5},
    {"type":"text","id":"anchor","label":"Section anchor","default":"explore-the-range"}
  ],
  "presets":[{"name":"Explore the Range"}]
}
{% endschema %}
