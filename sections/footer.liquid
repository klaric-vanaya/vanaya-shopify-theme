<style>
  .vanaya-footer-registered-office{
    display:flex;
    flex-direction:column;
    gap:3px;
    max-width:360px;
    margin-top:0;
    color:inherit;
    font-size:12px;
    line-height:1.55;
  }
  .vanaya-footer-registered-office strong{
    margin-bottom:2px;
    font-size:11px;
    font-weight:800;
    letter-spacing:.08em;
    text-transform:uppercase;
  }
  .vanaya-footer-office-title{
    display:inline-block;
    width:max-content;
    padding-bottom:3px;
    border-bottom:1px solid currentColor;
  }
  .vanaya-footer-cin{
    margin-top:8px;
    padding-top:8px;
    border-top:1px solid rgba(80,58,42,.18);
  }
  .vanaya-footer-contact{
    margin-top:9px;
    padding-top:9px;
    border-top:1px solid rgba(80,58,42,.18);
  }
  .vanaya-footer-registered-office span{
    display:block;
  }
  .vanaya-footer-registered-office b{
    font-weight:800;
  }
  @media(max-width:760px){
    .vanaya-footer-registered-office{
      margin-top:0;
      font-size:11px;
      line-height:1.5;
    }
  }
</style>


<style>
  /* v16 — compact homepage footer only */
  .template-index .vanaya-global-footer{
    padding-top:34px!important;
  }

  .template-index .vanaya-global-footer__grid{
    margin-bottom:28px!important;
    align-items:start!important;
  }

  .template-index .vanaya-global-footer__brand p{
    margin-top:10px!important;
    line-height:1.48!important;
  }

  /* Intentional breathing room between tagline and Registered Office */
  .template-index .vanaya-footer-registered-office{
    margin-top:17px!important;
    gap:2px!important;
    line-height:1.42!important;
  }

  .template-index .vanaya-footer-registered-office strong{
    margin-bottom:1px!important;
  }

  .template-index .vanaya-footer-office-title{
    padding-bottom:2px!important;
  }

  .template-index .vanaya-footer-cin{
    margin-top:6px!important;
    padding-top:6px!important;
  }

  .template-index .vanaya-footer-contact{
    margin-top:6px!important;
    padding-top:6px!important;
  }

  .template-index .vanaya-global-footer h4{
    margin-bottom:16px!important;
  }

  .template-index .vanaya-global-footer nav{
    gap:10px!important;
  }

  .template-index .vanaya-global-footer__journal p{
    margin-top:11px!important;
    line-height:1.48!important;
  }

  .template-index .vanaya-global-footer__journal form>div{
    margin-top:17px!important;
  }

  .template-index .vanaya-global-footer__journal input{
    padding-top:9px!important;
    padding-bottom:9px!important;
  }

  .template-index .vanaya-global-footer__journal button{
    padding-top:9px!important;
    padding-bottom:9px!important;
  }

  @media(max-width:650px){
    .template-index .vanaya-global-footer{
      padding-top:28px!important;
    }
    .template-index .vanaya-global-footer__grid{
      gap:26px 20px!important;
      margin-bottom:24px!important;
    }
    .template-index .vanaya-footer-registered-office{
      margin-top:14px!important;
    }

    /* Keep the injected mobile chevron clear of the final heading letter. */
    .template-index .vanaya-global-footer__grid > nav h4{
      box-sizing:border-box!important;
      width:100%!important;
      padding-right:24px!important;
    }
  }
</style>

{% schema %}
{
