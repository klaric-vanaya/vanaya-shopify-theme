<vanaya-promo-carousel class="vanaya-promo" role="region" aria-label="{{ 'vanaya_promo.label' | t }}" aria-roledescription="carousel" data-interval="{{ section.settings.interval | times: 1000 }}">
  <div class="vanaya-promo__viewport">
    <div class="vanaya-promo__track">
      <a href="{{ section.settings.offer_link | default: routes.all_products_collection_url }}" class="vanaya-promo__slide" aria-label="{{ 'vanaya_promo.offer_alt' | t }}">
        {% if section.settings.offer_image != blank %}
          {{ section.settings.offer_image | image_url: width: 2200 | image_tag: loading: 'lazy', widths: '640, 960, 1440, 2048', sizes: '100vw', alt: section.settings.offer_image.alt }}
        {% else %}
          <img src="https://cdn.shopify.com/s/files/1/0844/1449/7011/files/vanaya-quantity-discount-banner.jpg?v=1791287206" width="2048" height="692" loading="lazy" alt="{{ 'vanaya_promo.offer_alt' | t }}">
        {% endif %}
      </a>
      <a href="{{ section.settings.gift_link | default: '/pages/gifting' }}" class="vanaya-promo__slide" aria-label="{{ 'vanaya_promo.gift_alt' | t }}" inert aria-hidden="true">
        {% if section.settings.gift_image != blank %}
          {{ section.settings.gift_image | image_url: width: 2200 | image_tag: loading: 'lazy', widths: '640, 960, 1440, 1600', sizes: '100vw', alt: section.settings.gift_image.alt }}
        {% else %}
          <img src="https://cdn.shopify.com/s/files/1/0844/1449/7011/files/vanaya-diwali-bulk-orders-banner.jpg?v=1790670087" width="1600" height="540" loading="lazy" alt="{{ 'vanaya_promo.gift_alt' | t }}">
        {% endif %}
      </a>
    </div>
  </div>
  <button class="vanaya-promo__arrow vanaya-promo__arrow--prev vanaya-control-v20" type="button" data-promo-move="-1" aria-label="{{ 'vanaya_promo.previous' | t }}">←</button>
  <button class="vanaya-promo__arrow vanaya-promo__arrow--next vanaya-control-v20" type="button" data-promo-move="1" aria-label="{{ 'vanaya_promo.next' | t }}">→</button>
</vanaya-promo-carousel>

{% stylesheet %}
  .vanaya-promo{
    display:block;
    position:relative;
    width:100%;
    margin:0;
    padding:0;
    overflow:hidden;
    background:#fffaf0;
  }
  .vanaya-promo__viewport{
    width:100%;
    overflow:hidden;
  }
  .vanaya-promo__track{
    display:flex;
    width:100%;
    transform:translate3d(0,0,0);
    transition:transform .6s ease;
    will-change:transform;
  }
  .vanaya-promo__slide{
    display:block;
    flex:0 0 100%;
    width:100%;
    min-width:100%;
  }
  .vanaya-promo__slide img{
    display:block;
    width:100%;
    height:auto;
    aspect-ratio:2048/692;
    object-fit:contain;
  }
  .vanaya-promo__arrow{
    position:absolute;
    top:50%;
    z-index:4;
    display:grid!important;
    place-items:center!important;
    width:13px!important;
    min-width:13px!important;
    max-width:13px!important;
    height:13px!important;
    min-height:13px!important;
    max-height:13px!important;
    margin:0!important;
    padding:0!important;
    transform:translateY(-50%)!important;
    border:1px solid rgba(75,65,54,.45)!important;
    border-radius:50%!important;
    background:rgba(255,250,240,.9)!important;
    color:#4b4136!important;
    font:700 8px/1 Arial,sans-serif!important;
    box-shadow:none!important;
    cursor:pointer;
  }
  .vanaya-promo__arrow--prev{left:5px!important}
  .vanaya-promo__arrow--next{right:5px!important}
  @media(max-width:600px){
    .vanaya-promo__arrow{
      width:12px!important;
      min-width:12px!important;
      max-width:12px!important;
      height:12px!important;
      min-height:12px!important;
      max-height:12px!important;
      font-size:7px!important;
    }
    .vanaya-promo__arrow--prev{left:3px!important}
    .vanaya-promo__arrow--next{right:3px!important}
  }
  @media(prefers-reduced-motion:reduce){
    .vanaya-promo__track{transition:none}
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('vanaya-promo-carousel')) {
    customElements.define('vanaya-promo-carousel', class extends HTMLElement {
      connectedCallback() {
        if (this._ready) return;
        this._ready = true;
        this.track = this.querySelector('.vanaya-promo__track');
        this.slides = Array.from(this.querySelectorAll('.vanaya-promo__slide'));
        this.index = 0;
        this.timer = null;

        if (!this.track || this.slides.length < 2) return;

        this.querySelectorAll('[data-promo-move]').forEach((button) => {
          button.addEventListener('click', () => {
            this.move(Number(button.dataset.promoMove || 1));
            this.restart();
          });
        });

        this.addEventListener('mouseenter', () => clearInterval(this.timer));
        this.addEventListener('mouseleave', () => this.restart());

        let touchX = null;
        this.addEventListener('touchstart', (event) => {
          touchX = event.touches[0].clientX;
          clearInterval(this.timer);
        }, {passive:true});

        this.addEventListener('touchend', (event) => {
          if (touchX !== null) {
            const delta = event.changedTouches[0].clientX - touchX;
            if (Math.abs(delta) > 40) this.move(delta < 0 ? 1 : -1);
          }
          touchX = null;
          this.restart();
        }, {passive:true});

        this.show(0);
        this.restart();
      }

      show(index) {
        this.index = (index + this.slides.length) % this.slides.length;
        this.track.style.transform = 'translate3d(-' + (this.index * 100) + '%,0,0)';
        this.slides.forEach((slide, i) => {
          slide.toggleAttribute('inert', i !== this.index);
          slide.setAttribute('aria-hidden', i === this.index ? 'false' : 'true');
        });
      }

      move(direction) {
        this.show(this.index + direction);
      }

      restart() {
        clearInterval(this.timer);
        this.timer = setInterval(() => {
          if (!document.hidden) this.move(1);
        }, Number(this.dataset.interval) || 4000);
      }

      disconnectedCallback() {
        clearInterval(this.timer);
        this._ready = false;
      }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name":"Vanaya offer banners",
  "settings":[
    {"type":"image_picker","id":"offer_image","label":"Discount banner"},
    {"type":"url","id":"offer_link","label":"Discount banner link","default":"/collections/all"},
    {"type":"image_picker","id":"gift_image","label":"Diwali banner"},
    {"type":"url","id":"gift_link","label":"Diwali banner link"},
    {"type":"range","id":"interval","label":"Seconds between banners","min":4,"max":12,"step":1,"default":4}
  ],
  "presets":[{"name":"Vanaya offer banners"}]
}
{% endschema %}
