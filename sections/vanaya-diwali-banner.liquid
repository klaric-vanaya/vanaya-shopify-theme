<section class="vanaya-diwali-banner" aria-label="Vanaya Diwali gifting">
  <a href="/pages/gifting" class="vanaya-diwali-banner__link">
    <img
      src="https://cdn.shopify.com/s/files/1/0844/1449/7011/files/vanaya-diwali-bulk-orders-banner.jpg?v=1790670087"
      width="1600"
      height="540"
      loading="lazy"
      alt="Vanaya Diwali corporate gifting — now accepting bulk orders"
    >
  </a>
</section>

<style>
  #shopify-section-{{ section.id }}{margin:0!important;padding:0!important;background:#fffaf0}
  #shopify-section-{{ section.id }} .vanaya-diwali-banner{width:100%;margin:0;padding:0;overflow:hidden;background:#fffaf0}
  #shopify-section-{{ section.id }} .vanaya-diwali-banner__link{display:block;width:100%}
  #shopify-section-{{ section.id }} .vanaya-diwali-banner img{display:block;width:100%;height:auto}
</style>

{% schema %}
{
  "name":"Vanaya Diwali Banner",
  "settings":[],
  "presets":[{"name":"Vanaya Diwali Banner"}]
}
{% endschema %}
