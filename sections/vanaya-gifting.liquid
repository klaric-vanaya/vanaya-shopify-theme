{% liquid
  assign diwali_box_1 = all_products['diwali-gift-box-1-kansa-5-ml-oil-duo-mirror']
  assign diwali_box_2 = all_products['diwali-gift-box-2-kansa-sea-buckthorn-10-ml']
  assign diwali_box_3 = all_products['customizable-diwali-gift-box-3-kansa-any-30-ml-oil']
  assign complete_box = all_products['the-complete-ritual-gift-box']
  assign glow_box = all_products['the-glow-essentials-gift-box']
  if complete_box == blank
    assign complete_box = all_products['complete-ritual-gift-box']
  endif
  if glow_box == blank
    assign glow_box = all_products['glow-essentials-gift-box']
  endif
  if complete_box == blank or glow_box == blank
    for gift_candidate in collections.all.products
      assign gift_candidate_title = gift_candidate.title | downcase
      if complete_box == blank and gift_candidate_title contains 'complete ritual gift box'
        assign complete_box = gift_candidate
      endif
      if glow_box == blank and gift_candidate_title contains 'glow essentials gift box'
        assign glow_box = gift_candidate
      endif
    endfor
  endif
%}

<section class="vgift-premium">
  <header class="vgift-premium__hero vgift-premium__hero--banner">
    <h1 class="vgift-premium__accessible-title">{{ 'vanaya_gifting.title' | t }}</h1>
    <a href="#vanaya-gift-collection">
      <img src="{{ 'vanaya-diwali-2026-1.webp' | asset_url }}" width="2048" height="853" alt="{{ 'vanaya_gifting.banner_alt' | t | escape }}" loading="eager" fetchpriority="high">
    </a>
  </header>

  <div class="vgift-premium__introduction" id="vanaya-gift-collection">
    <p>Curated with intention</p>
    <h2>Five expressions of thoughtful care</h2>
    <div><span>Ayurvedic hero formulations</span><span>Premium gift-ready presentation</span><span>Made for lasting rituals</span></div>
  </div>

  {% render 'vanaya-gift-box',
    product: diwali_box_1,
    fallback_handle: 'diwali-gift-box-1-kansa-5-ml-oil-duo-mirror',
    number: '01',
    eyebrow: 'Diwali Edit · 40% Off',
    title: 'Diwali Gift Box 1 – Kansa, 5 ml Oil Duo & Mirror',
    subtitle: 'Kansa Wand · Sea Buckthorn 5 ml · Kumkumadi 5 ml · Mirror',
    description: 'A festive Vanaya ritual bringing together the Kansa Wand, two travel-sized hero oils and a keepsake mirror in our signature Diwali gift presentation.',
    contents: 'Kansa Wand - 1 unit|Sea Buckthorn Oil - 5 ml|Kumkumadi Tailam - 5 ml|Vanaya Mirror - 1 unit',
    fallback_price: '₹2,069',
    fallback_compare: '₹3,447',
    custom_image_keyword: 'inner',
    best_for: 'A complete festive self-care gift with ritual tools, facial oils and a keepsake mirror.'
  %}

  {% render 'vanaya-gift-box',
    product: diwali_box_2,
    fallback_handle: 'diwali-gift-box-2-kansa-sea-buckthorn-10-ml',
    number: '02',
    eyebrow: 'Diwali Edit · 40% Off',
    title: 'Diwali Gift Box 2 – Kansa & Sea Buckthorn 10 ml',
    subtitle: 'Kansa Wand · Sea Buckthorn Oil 10 ml',
    description: 'A focused glow ritual pairing our traditional Kansa Wand with Sea Buckthorn Oil in a festive Vanaya presentation.',
    contents: 'Kansa Wand - 1 unit|Sea Buckthorn Oil - 10 ml',
    fallback_price: '₹1,588',
    fallback_compare: '₹2,647',
    custom_image_keyword: 'inner',
    best_for: 'A compact festive gift for facial massage, nourishment and an elevated daily ritual.',
    reverse: true
  %}

  {% render 'vanaya-gift-box',
    product: diwali_box_3,
    fallback_handle: 'customizable-diwali-gift-box-3-kansa-any-30-ml-oil',
    number: '03',
    eyebrow: 'Customizable Diwali Edit · 30% Off',
    title: 'Customizable Diwali Gift Box 3 – Kansa & Any 30 ml Oil',
    subtitle: 'Kansa Wand · Choose any one 30 ml Vanaya facial oil',
    description: 'Create a more personal Diwali ritual by pairing the Kansa Wand with your choice of a full-size 30 ml Vanaya facial oil. Variant pricing updates according to the selected oil.',
    contents: 'Kansa Wand - 1 unit|Choose Sea Buckthorn Oil - 30 ml|or Haridradyam Tailam - 30 ml|or Kumkumadi Tailam - 30 ml|or Kanak Tailam - 30 ml',
    fallback_price: 'From ₹2,025',
    fallback_compare: 'MRP varies by oil',
    custom_image_keyword: 'inner',
    best_for: 'A customizable premium Diwali gift where the recipient’s 30 ml facial oil can be selected.',
  %}

  <div class="vgift-premium__previous">
    <p>Vanaya Signature Gift Boxes</p>
    <h2>Our original gifting rituals</h2>
  </div>

  {% render 'vanaya-gift-box', product: complete_box, fallback_handle: 'the-complete-ritual-gift-box', number: '04', eyebrow: 'The full Vanaya experience', title: 'The Complete Ritual Gift Box', subtitle: 'Six products · A complete face-and-eye ritual', description: "One box, a full ritual. Vanaya's two hero oils meet overnight repair, a brightening ubtan, gentle exfoliation and under-eye care. Rooted in Ayurveda and built on Kumkumadi and Saffron, it brings hydration, repair, exfoliation and glow together - nothing extra, nothing missing.", contents: 'Sea Buckthorn Oil - 5 ml|Kumkumadi Tailam - 5 ml|Ratri Glow Night Cream - 12 gm|Chamak Damak Glow Ubtan - 12 gm|Tara Sitara Exfoliating Scrub - 12 gm|Nayan Tara Under Eye Cream - 12 gm', fallback_price: '₹1,649', fallback_compare: '₹3,295', custom_image_keyword: '06', best_for: 'A complete Ayurvedic skincare ritual for hydration, exfoliation, overnight repair and under-eye care.' %}

  {% render 'vanaya-gift-box', product: glow_box, fallback_handle: 'the-glow-essentials-gift-box', number: '05', eyebrow: 'The essential glow edit', title: 'The Glow Essentials Gift Box', subtitle: 'Four products + Kaansa Wand', description: "Our essentials, minus nothing. Two hero Vanaya oils and two Kumkumadi and Saffron creams are paired with a traditional Kaansa wand - used in Ayurveda to support circulation and help de-puff the skin. A focused edit that still completes the ritual.", contents: 'Sea Buckthorn Oil - 5 ml|Kumkumadi Tailam - 5 ml|Ratri Glow Night Cream - 12 gm|Chamak Damak Glow Ubtan - 12 gm|Kaansa Wand - 1 unit', fallback_price: '₹2,349', fallback_compare: '₹3,956', best_for: 'Vanaya essentials with a traditional touch and an elevated at-home facial ritual.', reverse: true %}

  <footer class="vgift-premium__closing">
    <p>For celebrations · For gratitude · For someone special</p>
    <h2>A gift that becomes<br><em>their daily ritual.</em></h2>
    <a href="{{ routes.all_products_collection_url }}">Explore all Vanaya rituals</a>
  </footer>
</section>

<style>
.vgift-premium{--gift-ink:#392f25;--gift-sage:#d4d2b4;--gift-cream:#fbf7eb;background:var(--gift-cream);color:var(--gift-ink);font-family:"Avenir Next",Avenir,Arial,sans-serif}.vgift-premium__hero{position:relative;display:flex;min-height:660px;align-items:center;justify-content:center;flex-direction:column;padding:100px 24px;text-align:center;background:radial-gradient(circle at 50% 36%,rgba(255,255,255,.88),rgba(245,239,218,.72) 39%,rgba(212,210,180,.95) 100%);overflow:hidden}.vgift-premium__hero:before,.vgift-premium__hero:after{position:absolute;width:38vw;height:38vw;max-width:520px;max-height:520px;border:1px solid rgba(75,65,54,.16);border-radius:50%;content:""}.vgift-premium__hero:before{left:-15vw;top:-16vw}.vgift-premium__hero:after{right:-15vw;bottom:-18vw}.vgift-premium__kicker,.vgift-premium__introduction>p{margin:0;color:#745f43;font-size:10px;font-weight:800;letter-spacing:.24em;text-transform:uppercase}.vgift-premium__hero h1{position:relative;z-index:1;margin:20px 0 25px;font:400 clamp(55px,8vw,110px)/.91 Georgia,serif;letter-spacing:-.045em}.vgift-premium__hero h1 em,.vgift-premium__closing em{font-weight:400}.vgift-premium__hero>p:not(.vgift-premium__kicker){position:relative;z-index:1;max-width:720px;margin:0;font:17px/1.75 Georgia,serif}.vgift-premium__hero>a{position:relative;z-index:1;margin-top:34px;padding-bottom:7px;border-bottom:1px solid;color:inherit;font-size:10px;font-weight:800;letter-spacing:.16em;text-decoration:none;text-transform:uppercase}.vgift-premium__hero>a span{margin-left:8px}.vgift-premium__introduction{padding:88px 22px 58px;text-align:center}.vgift-premium__introduction h2{margin:13px 0 32px;font:400 clamp(38px,5vw,66px)/1.05 Georgia,serif}.vgift-premium__introduction div{display:flex;justify-content:center;gap:0;flex-wrap:wrap}.vgift-premium__introduction span{padding:7px 24px;border-right:1px solid rgba(57,47,37,.25);font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.vgift-premium__introduction span:last-child{border-right:0}.vgift-premium__closing{padding:95px 24px;text-align:center;background:#efe6d8;color:#5a4636}.vgift-premium__closing,.vgift-premium__closing p,.vgift-premium__closing h2,.vgift-premium__closing h2 em{color:#5a4636!important}.vgift-premium__closing p{font-size:9px;font-weight:800;letter-spacing:.2em;text-transform:uppercase}.vgift-premium__closing h2{margin:20px auto 30px;font:400 clamp(42px,6vw,80px)/1 Georgia,serif}.vgift-premium__closing a{display:inline-flex;min-height:49px;align-items:center;padding:0 25px;border:1px solid rgba(90,70,54,.55);color:#5a4636;font-size:10px;font-weight:800;letter-spacing:.13em;text-decoration:none;text-transform:uppercase}@media(max-width:700px){.vgift-premium__hero{min-height:540px;padding:76px 17px}.vgift-premium__hero>p:not(.vgift-premium__kicker){font-size:15px}.vgift-premium__introduction{padding:62px 16px 35px}.vgift-premium__introduction div{flex-direction:column;gap:10px}.vgift-premium__introduction span{border:0}.vgift-premium__closing{padding:70px 16px}}
.vgift-premium__previous{padding:40px 20px 6px;text-align:center}.vgift-premium__previous p{margin:0;color:#745f43;font-size:10px;font-weight:800;letter-spacing:.22em;text-transform:uppercase}.vgift-premium__previous h2{margin:12px 0 0;font:400 clamp(36px,4.6vw,58px)/1.05 Georgia,serif;color:#392f25}@media(max-width:700px){.vgift-premium__previous{padding:24px 14px 0}.vgift-premium__previous h2{font-size:34px}}
</style>

<style>
.vgift-premium__hero{min-height:440px!important;padding:64px 24px!important}.vgift-premium__introduction{padding:55px 22px 28px!important}.vgift-premium__introduction h2{margin-bottom:24px!important}@media(max-width:700px){.vgift-premium__hero{min-height:390px!important;padding:52px 16px!important}.vgift-premium__introduction{padding:45px 14px 24px!important}}
.vgift-premium .vgift-premium__hero--banner{display:block;min-height:0!important;padding:0!important;background:none}.vgift-premium__hero--banner:before,.vgift-premium__hero--banner:after{display:none}.vgift-premium__hero--banner>a{display:block;margin:0;padding:0;border:0}.vgift-premium__hero--banner img{display:block;width:100%;height:auto}.vgift-premium__hero--banner .vgift-premium__accessible-title{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}
</style>
