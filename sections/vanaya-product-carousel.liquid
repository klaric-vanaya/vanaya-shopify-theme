{% assign visible_count = section.blocks.size %}
{% if section.settings.heading == 'Most Loved' %}{% assign visible_count = 4 %}{% endif %}
{% assign is_most_loved = false %}
{% if section.settings.heading == 'Most Loved' %}{% assign is_most_loved = true %}{% endif %}
<section class="vanaya-section vanaya-products{% if section.settings.heading == 'Explore the Range' %} vanaya-products--explore{% else %} vanaya-products--loved{% endif %}{% if is_most_loved %} vanaya-products--static{% endif %}" id="{{ section.settings.anchor | handle }}"{% unless is_most_loved %} data-vanaya-products data-product-autoplay="true" data-scroll-mode="item"{% endunless %}>
  <div class="vanaya-heading">
    <div><p class="vanaya-kicker">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>
    {% if visible_count > 1 and is_most_loved == false %}
      <div class="vanaya-carousel-tools">
        <span data-page-label>01 / {{ visible_count | prepend: '0' | slice: -2, 2 }}</span>
        <button class="vanaya-control-v20" type="button" data-product-move="-1" aria-label="Previous product">←</button>
        <button class="vanaya-control-v20" type="button" data-product-move="1" aria-label="Next product">→</button>
      </div>
    {% endif %}
  </div>
  <div class="vanaya-product-window">
    <div class="vanaya-product-track vanaya-product-track--items" data-track>
      {% for block in section.blocks %}
        {% if forloop.index0 < visible_count %}
          {% assign product = block.settings.product %}
          <article class="vanaya-card{% if section.settings.heading == 'Most Loved' %} vanaya-card--double{% endif %}" data-product-card {{ block.shopify_attributes }}>
            {% if product != blank %}<button type="button" class="v29-wishlist-btn" data-v29-wishlist data-handle="{{ product.handle }}" data-title="{{ product.title | escape }}" data-url="{{ product.url }}" data-image="{{ product.featured_image | image_url: width: 700 }}" data-price="{{ product.price | money | escape }}" data-variant-id="{{ product.selected_or_first_available_variant.id }}" aria-label="Save {{ product.title | escape }} to wishlist" aria-pressed="false">♡</button>{% endif %}
            <a class="vanaya-card-media{% if is_most_loved %} vanaya-card-media--loved{% endif %}" href="{% if product != blank %}{{ product.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">
              <span class="vanaya-card-image-stack">
                {% if is_most_loved %}
                  {% assign ml_primary = block.settings.image %}
                  {% if ml_primary == blank and product != blank %}
                    {% assign ml_primary = product.featured_image %}
                  {% endif %}
                  {% assign ml_hover = block.settings.hover_image %}
                  {% if ml_hover == blank and product != blank and product.images.size > 1 %}
                    {% assign ml_hover = product.images[1] %}
                  {% endif %}

                  {% if ml_primary != blank %}
                    <img
                      class="vanaya-card-image-primary"
                      src="{{ ml_primary | image_url: width: 1000 }}"
                      srcset="{{ ml_primary | image_url: width: 400 }} 400w, {{ ml_primary | image_url: width: 600 }} 600w, {{ ml_primary | image_url: width: 800 }} 800w, {{ ml_primary | image_url: width: 1000 }} 1000w"
                      sizes="(max-width: 800px) 50vw, 25vw"
                      loading="eager"
                      alt="{% if product != blank %}{{ product.title | escape }}{% else %}{{ block.settings.title | escape }}{% endif %}"
                      {% if ml_hover != blank %}
                        data-ml-original-src="{{ ml_primary | image_url: width: 1000 }}"
                        data-ml-original-srcset="{{ ml_primary | image_url: width: 400 }} 400w, {{ ml_primary | image_url: width: 600 }} 600w, {{ ml_primary | image_url: width: 800 }} 800w, {{ ml_primary | image_url: width: 1000 }} 1000w"
                        data-ml-hover-src="{{ ml_hover | image_url: width: 1000 }}"
                        data-ml-hover-srcset="{{ ml_hover | image_url: width: 400 }} 400w, {{ ml_hover | image_url: width: 600 }} 600w, {{ ml_hover | image_url: width: 800 }} 800w, {{ ml_hover | image_url: width: 1000 }} 1000w"
                      {% endif %}
                    >
                  {% elsif block.settings.fallback_asset != blank %}
                    <img class="vanaya-card-image-primary" src="{{ block.settings.fallback_asset | asset_url }}" loading="eager" width="1000" height="1000" alt="{{ block.settings.title | escape }}">
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'vanaya-card-image-primary' }}
                  {% endif %}
                {% else %}
                  {% if block.settings.image != blank %}
                    {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'eager', widths: '400,600,800,1000', alt: block.settings.title, class: 'vanaya-card-image-primary' }}
                  {% elsif product != blank and product.featured_image != blank %}
                    {{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'eager', widths: '400,600,800,1000', alt: product.title, class: 'vanaya-card-image-primary' }}
                  {% elsif block.settings.fallback_asset != blank %}
                    <img class="vanaya-card-image-primary" src="{{ block.settings.fallback_asset | asset_url }}" loading="eager" width="1000" height="1000" alt="{{ block.settings.title | escape }}">
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'vanaya-card-image-primary' }}
                  {% endif %}
                {% endif %}

                {% if section.settings.heading == 'Explore the Range' %}
                  {% if block.settings.hover_image != blank %}
                    {{ block.settings.hover_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,600,800,1000', alt: block.settings.title, class: 'vanaya-card-image-secondary' }}
                  {% elsif product != blank and product.media.size > 1 %}
                    {{ product.media[1].preview_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,600,800,1000', alt: product.title, class: 'vanaya-card-image-secondary' }}
                  {% elsif block.settings.fallback_hover_asset != blank %}
                    <img class="vanaya-card-image-secondary" src="{{ block.settings.fallback_hover_asset | asset_url }}" loading="lazy" width="1000" height="1000" alt="{{ block.settings.title | escape }}">
                  {% endif %}
                {% endif %}
              </span>
            </a>
            <div class="vanaya-card-copy">
              <small>{{ block.settings.subtitle }}</small>
              <h3>{% if product != blank %}{{ product.title }}{% else %}{{ block.settings.title }}{% if block.settings.measurement != blank %} <span class="vanaya-card-measurement">{{ block.settings.measurement }}</span>{% endif %}{% endif %}</h3>
              <span class="vanaya-price">{% if product != blank %}{{ product.price | money }}{% else %}{{ block.settings.price }}{% endif %}</span>
              {% if is_most_loved %}
                <div class="vanaya-card-actions-v23">
                  <a class="vanaya-card-button vanaya-button-v20" href="{% if product != blank %}{{ product.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"><span>Discover</span></a>
                  {% if product != blank %}
                    <button
                      class="vanaya-card-button vanaya-button-v20 vanaya-quick-add-v23"
                      type="button"
                      data-vanaya-quick-add
                      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                      data-product-url="{{ product.url }}"
                      {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
                    >{% if product.selected_or_first_available_variant.available %}Add to Bag{% else %}Sold Out{% endif %}</button>
                  {% endif %}
                </div>
              {% else %}
                <a class="vanaya-card-button vanaya-button-v20" href="{% if product != blank %}{{ product.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"><span>Discover</span></a>
              {% endif %}
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
    {% if visible_count > 1 and is_most_loved == false %}
      <button class="vanaya-product-edge-arrow vanaya-product-edge-arrow--prev vanaya-control-v20" type="button" data-product-move="-1" aria-label="View previous product">←</button>
      <button class="vanaya-product-edge-arrow vanaya-product-edge-arrow--next vanaya-control-v20" type="button" data-product-move="1" aria-label="View next product">→</button>
    {% endif %}
  </div>
  {% if visible_count > 1 and is_most_loved == false %}<div class="vanaya-progress">{% for block in section.blocks limit: visible_count %}<span data-progress{% if forloop.first %} class="active"{% endif %}></span>{% endfor %}</div>{% endif %}
</section>

{% if is_most_loved %}
<style>
  /* Dedicated Most Loved badge: isolated from the theme's shared badge rules. */
  .template-index #root .vanaya-products--loved .vanaya-card-media--loved{
    position:relative!important;
    display:block!important;
  }
  .template-index #root .vanaya-products--loved .vanaya-card-media--loved::after{
    content:"BEST SELLER"!important;
    position:absolute!important;
    z-index:30!important;
    display:block!important;
    top:14px!important;
    right:auto!important;
    bottom:auto!important;
    left:14px!important;
    width:auto!important;
    height:auto!important;
    margin:0!important;
    padding:7px 11px!important;
    border:0!important;
    border-radius:50px!important;
    background:var(--v-sage)!important;
    color:#20271c!important;
    font-family:Arial,Helvetica,sans-serif!important;
    font-size:9px!important;
    font-weight:800!important;
    line-height:1.2!important;
    letter-spacing:.12em!important;
    text-align:left!important;
    text-indent:0!important;
    text-transform:uppercase!important;
    opacity:1!important;
    visibility:visible!important;
    transform:none!important;
    pointer-events:none!important;
  }
  .template-index #root .vanaya-products--loved .vanaya-card-actions-v23{
    display:grid!important;
    grid-template-columns:repeat(2,minmax(0,1fr))!important;
    gap:9px!important;
    width:100%!important;
  }
  .template-index #root .vanaya-products--loved .vanaya-card-actions-v23 .vanaya-card-button{
    width:100%!important;
    min-width:0!important;
    min-height:43px!important;
    margin:0!important;
    padding:8px 10px!important;
    cursor:pointer!important;
    font-size:10px!important;
    line-height:1.15!important;
  }
  .template-index #root .vanaya-products--loved .vanaya-card-actions-v23 .vanaya-quick-add-v23{
    background:#4b4136!important;
    color:#fffaf0!important;
  }
  .template-index #root .vanaya-products--loved .vanaya-card-actions-v23 .vanaya-quick-add-v23:disabled{
    cursor:not-allowed!important;
    opacity:.55!important;
  }
  @media(max-width:600px){
    .template-index #root .vanaya-products--loved .vanaya-card-actions-v23{
      gap:6px!important;
    }
    .template-index #root .vanaya-products--loved .vanaya-card-actions-v23 .vanaya-card-button{
      min-height:38px!important;
      padding:7px 4px!important;
      font-size:8px!important;
      letter-spacing:.06em!important;
    }
  }
</style>
<script>
document.addEventListener('DOMContentLoaded', function () {
  var section = document.getElementById('{{ section.settings.anchor | handle }}');
  if (!section) return;

  section.querySelectorAll('.vanaya-card').forEach(function(card) {
    var img = card.querySelector('img.vanaya-card-image-primary[data-ml-hover-src]');
    if (!img) return;

    card.addEventListener('mouseenter', function() {
      img.src = img.dataset.mlHoverSrc;
      if (img.dataset.mlHoverSrcset) img.srcset = img.dataset.mlHoverSrcset;
    });

    card.addEventListener('mouseleave', function() {
      img.src = img.dataset.mlOriginalSrc;
      if (img.dataset.mlOriginalSrcset) img.srcset = img.dataset.mlOriginalSrcset;
    });
  });
});

if (!window.VanayaQuickAddV23) {
  window.VanayaQuickAddV23 = true;
  document.addEventListener('click', async function(event) {
    var button = event.target.closest('[data-vanaya-quick-add]');
    if (!button || button.disabled) return;
    event.preventDefault();
    event.stopPropagation();

    var variantId = Number(button.dataset.variantId || 0);
    if (!variantId) {
      if (button.dataset.productUrl) window.location.href = button.dataset.productUrl;
      return;
    }

    var originalText = button.textContent;
    button.disabled = true;
    button.textContent = 'Adding…';

    try {
      var response = await fetch('{{ routes.cart_add_url }}.js', {
        method: 'POST',
        credentials: 'same-origin',
        headers: {'Content-Type':'application/json','Accept':'application/json'},
        body: JSON.stringify({items:[{id:variantId,quantity:1}]})
      });
      if (!response.ok) throw new Error('Unable to add product');

      var cartResponse = await fetch('{{ routes.cart_url }}.js', {credentials:'same-origin'});
      if (cartResponse.ok) {
        var cart = await cartResponse.json();
        document.querySelectorAll('#cart-count, #cart-count--m').forEach(function(count) {
          count.textContent = cart.item_count;
        });
      }

      button.textContent = 'Added ✓';
      setTimeout(function() {
        button.disabled = false;
        button.textContent = originalText;
      }, 1500);
    } catch (error) {
      button.disabled = false;
      button.textContent = originalText;
      if (button.dataset.productUrl) window.location.href = button.dataset.productUrl;
    }
  });
}
</script>
{% endif %}

{% schema %}
{"name":"Vanaya product carousel","max_blocks":12,"settings":[
{"type":"text","id":"anchor","label":"Section anchor","default":"the-vanaya-edit"},
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A considered selection"},
{"type":"text","id":"heading","label":"Heading","default":"The Vanaya Edit"}
],"blocks":[{"type":"product","name":"Product card","settings":[
{"type":"product","id":"product","label":"Shopify product","info":"Select the actual Shopify product so its complete live title—including measurement—appears automatically."},
{"type":"image_picker","id":"image","label":"Custom card image"},
{"type":"image_picker","id":"hover_image","label":"Second image on hover","info":"Used in Explore the Range. If blank, the Shopify product's second media image is used automatically."},
{"type":"text","id":"fallback_asset","label":"Included asset filename"},
{"type":"text","id":"fallback_hover_asset","label":"Included second-image filename","info":"Optional fallback second image for hover."},
{"type":"text","id":"badge","label":"Badge","default":"The Edit"},
{"type":"text","id":"subtitle","label":"Subtitle","default":"Ayurvedic skincare ritual"},
{"type":"text","id":"title","label":"Fallback title","default":"Vanaya ritual"},
{"type":"text","id":"measurement","label":"Fallback measurement","info":"Used only when no Shopify product is selected, for example 30 ml or 50 g."},
{"type":"text","id":"price","label":"Fallback price","default":"₹1,599"}
]}],"presets":[{"name":"Vanaya product carousel"}]}
{% endschema %}
