<section id="vanaya-community" class="vanaya-section vanaya-testimonials v291-testimonials" data-vanaya-testimonials aria-label="{{ section.settings.heading | escape }}">
  <div class="v291-testimonial-heading">
    <p class="vanaya-kicker">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <div class="v291-testimonial-heading-stars" aria-label="5 out of 5 stars">
      {% for i in (1..5) %}
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.7l2.85 5.77 6.37.93-4.61 4.49 1.09 6.34L12 17.58l-5.7 3 1.09-6.34-4.61-4.49 6.37-.93L12 2.7z"/></svg>
      {% endfor %}
    </div>
    <p>{{ section.settings.intro }}</p>
  </div>

  <div class="v291-testimonial-shell">
    <button class="v291-testimonial-arrow v291-testimonial-arrow--prev" type="button" data-testimonial-prev aria-label="Previous customer story">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7"/></svg>
    </button>

    <div class="v291-testimonial-window">
      <div class="v291-testimonial-track" data-testimonial-track>
        {% for block in section.blocks %}
          <article class="v291-testimonial-card" {{ block.shopify_attributes }}>
            <div class="v291-testimonial-photo-wrap">
              {% if block.settings.photo_asset != blank %}
                <img class="v291-testimonial-photo"
                     src="{{ block.settings.photo_asset | asset_url }}"
                     alt="{{ block.settings.customer | escape }}"
                     loading="lazy"
                     width="360"
                     height="360">
              {% else %}
                <span class="v291-testimonial-fallback">{{ block.settings.customer | slice: 0, 1 }}</span>
              {% endif %}
              <span class="v291-testimonial-verified" aria-label="Vanaya customer">✓</span>
            </div>

            <div class="v291-testimonial-stars" aria-label="{{ block.settings.rating }} out of 5 stars">
              {% for i in (1..5) %}{% if i <= block.settings.rating %}★{% else %}☆{% endif %}{% endfor %}
            </div>

            <span class="v291-testimonial-mark" aria-hidden="true">“</span>
            <blockquote>{{ block.settings.quote | escape }}</blockquote>

            <footer>
              <strong>{{ block.settings.customer | escape }}</strong>
              <span>{{ block.settings.product | escape }}</span>
            </footer>
          </article>
        {% endfor %}
      </div>
    </div>

    <button class="v291-testimonial-arrow v291-testimonial-arrow--next" type="button" data-testimonial-next aria-label="Next customer story">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7"/></svg>
    </button>
  </div>

  <div class="v291-testimonial-dots" data-testimonial-dots aria-label="Customer stories"></div>
</section>

<script>
(() => {
  const root = document.currentScript.previousElementSibling;
  if (!root) return;
  const track = root.querySelector('[data-testimonial-track]');
  const cards = Array.from(track.children);
  const dots = root.querySelector('[data-testimonial-dots]');
  if (!cards.length) return;

  let index = 0;
  let timer = null;
  const visible = () => window.innerWidth <= 700 ? 1 : (window.innerWidth <= 1050 ? 2 : 4);
  const maxIndex = () => Math.max(0, cards.length - visible());

  const buildDots = () => {
    dots.innerHTML = '';
    for (let i = 0; i <= maxIndex(); i++) {
      const b = document.createElement('button');
      b.type = 'button';
      b.setAttribute('aria-label', `Show customer story ${i + 1}`);
      b.addEventListener('click', () => { index = i; render(); restart(); });
      dots.appendChild(b);
    }
  };

  const render = () => {
    index = Math.min(index, maxIndex());
    const gap = parseFloat(getComputedStyle(track).gap) || 22;
    const step = cards[0].getBoundingClientRect().width + gap;
    track.style.transform = `translate3d(${-index * step}px,0,0)`;
    Array.from(dots.children).forEach((dot, i) => dot.classList.toggle('is-active', i === index));
  };

  const move = dir => {
    const max = maxIndex();
    index = dir > 0 ? (index >= max ? 0 : index + 1) : (index <= 0 ? max : index - 1);
    render();
  };

  const restart = () => {
    clearInterval(timer);
    timer = setInterval(() => move(1), {{ section.settings.speed | times: 1000 }});
  };

  root.querySelector('[data-testimonial-prev]').addEventListener('click', () => { move(-1); restart(); });
  root.querySelector('[data-testimonial-next]').addEventListener('click', () => { move(1); restart(); });
  root.addEventListener('mouseenter', () => clearInterval(timer));
  root.addEventListener('mouseleave', restart);
  root.addEventListener('focusin', () => clearInterval(timer));
  root.addEventListener('focusout', restart);

  let startX = null;
  root.addEventListener('touchstart', e => startX = e.touches[0].clientX, {passive:true});
  root.addEventListener('touchend', e => {
    if (startX === null) return;
    const dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 45) move(dx < 0 ? 1 : -1);
    startX = null;
    restart();
  }, {passive:true});

  window.addEventListener('resize', () => { buildDots(); render(); }, {passive:true});
  buildDots();
  render();
  restart();
})();
</script>

{% schema %}
{
  "name":"Vanaya customer feedback",
  "max_blocks":10,
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Words from the Vanaya community"},
    {"type":"text","id":"heading","label":"Heading","default":"Loved Beyond the First Use"},
    {"type":"text","id":"intro","label":"Introductory text","default":"Real routines, thoughtful formulas and the little rituals our community keeps coming back to."},
    {"type":"range","id":"speed","label":"Auto-scroll interval","min":3,"max":10,"step":1,"unit":"s","default":5}
  ],
  "blocks":[
    {
      "type":"review",
      "name":"Customer feedback",
      "settings":[
        {"type":"range","id":"rating","label":"Rating","min":1,"max":5,"step":1,"default":5},
        {"type":"textarea","id":"quote","label":"Feedback","default":"Add customer feedback here."},
        {"type":"text","id":"customer","label":"Customer name","default":"Customer name"},
        {"type":"text","id":"product","label":"Product or ritual","default":"Vanaya ritual"},
        {"type":"text","id":"photo_asset","label":"Theme asset filename","default":"customer-aryan-jindal.webp","info":"Example: customer-aryan-jindal.webp"}
      ]
    }
  ],
  "presets":[{"name":"Vanaya customer feedback"}]
}
{% endschema %}
