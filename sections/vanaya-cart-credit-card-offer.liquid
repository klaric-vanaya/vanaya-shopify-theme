{% unless cart.item_count == 0 %}
<section class="vanaya-cart-credit-card-offer" role="note" aria-label="Credit card offer">
  <span class="vanaya-cart-credit-card-offer__icon" aria-hidden="true">%</span>
  <div>
    <strong>Flat 10% Instant Discount on all Major Credit Cards on Order Value 999/- or Above</strong>
    <span>Pay by an eligible major credit card at checkout to enjoy the instant offer on qualifying orders.</span>
  </div>
</section>

<style>

  /* Keep only the first cart credit-card offer if Shopify still renders an older duplicate section. */
  body.template-cart .shopify-section:has(.vanaya-cart-credit-card-offer)
  ~ .shopify-section:has(.vanaya-cart-credit-card-offer){
    display:none!important;
  }
  #shopify-section-{{ section.id }}{margin:0!important;padding:0!important}
  #shopify-section-{{ section.id }} .vanaya-cart-credit-card-offer{
    width:calc(100vw - 72px);
    max-width:1720px;
    margin:18px auto 16px;
    padding:16px 22px;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:14px;
    border:2px solid #8a6a3f;
    border-radius:14px;
    background:linear-gradient(90deg,#f1e3a8 0%,#fff8dc 50%,#f1e3a8 100%);
    color:#4b3929;
    text-align:center;
    box-shadow:0 10px 28px rgba(90,70,50,.16), inset 0 0 0 1px rgba(255,255,255,.45);
  }
  #shopify-section-{{ section.id }} .vanaya-cart-credit-card-offer__icon{
    flex:0 0 34px;
    width:34px;
    height:34px;
    display:grid;
    place-items:center;
    border-radius:50%;
    background:#5a4632;
    color:#fffaf0;
    font-size:15px;
    font-weight:900;
  }
  #shopify-section-{{ section.id }} .vanaya-cart-credit-card-offer strong{
    display:block;
    font-size:17px;
    line-height:1.25;
  }
  #shopify-section-{{ section.id }} .vanaya-cart-credit-card-offer div>span{
    display:block;
    margin-top:2px;
    color:#756650;
    font-size:11px;
    line-height:1.35;
  }
  @media(max-width:760px){
    #shopify-section-{{ section.id }} .vanaya-cart-credit-card-offer{
      width:calc(100% - 28px);
      margin:12px auto 14px;
      padding:13px 14px;
      gap:9px;
      text-align:left;
    }
    #shopify-section-{{ section.id }} .vanaya-cart-credit-card-offer strong{font-size:12px}
    #shopify-section-{{ section.id }} .vanaya-cart-credit-card-offer div>span{font-size:9px}
  }
</style>


{% endunless %}

{% schema %}
{
  "name":"Cart Card Offer",
  "settings":[],
  "presets":[{"name":"Cart Card Offer"}]
}
{% endschema %}
