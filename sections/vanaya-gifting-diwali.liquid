{% liquid
  assign box1 = all_products['diwali-gift-box-1-kansa-5-ml-oil-duo-mirror']
  assign box2 = all_products['diwali-gift-box-2-kansa-sea-buckthorn-10-ml']
  assign box3 = all_products['customizable-diwali-gift-box-3-kansa-any-30-ml-oil']
  assign complete_box = all_products['the-complete-ritual-gift-box']
  assign glow_box = all_products['the-glow-essentials-gift-box']
%}

<main class="vdiwali-gifting">
  <section class="vdiwali-gifting__hero">
    <div class="vdiwali-gifting__hero-copy">
      <p class="vdiwali-gifting__kicker">VANAYA · FESTIVE EDIT</p>
      <h1>Diwali Gifting</h1>
      <h2>Rituals of Care. Gifts of Radiance.</h2>
      <p>This Diwali, gift thoughtful Ayurvedic rituals for naturally luminous-looking skin — beautifully presented in Vanaya's limited festive boxes.</p>
      <a href="#diwali-gift-boxes">Explore Diwali Gift Boxes <span>→</span></a>
      <div class="vdiwali-gifting__benefits">
        <span>✦ Pure & Ayurvedic</span>
        <span>✦ Beautifully Packaged</span>
        <span>✦ Thoughtful & Meaningful</span>
        <span>✦ Festive Ready</span>
      </div>
    </div>
    <div class="vdiwali-gifting__hero-visual" aria-hidden="true">
      <img src="https://cdn.shopify.com/s/files/1/0844/1449/7011/files/vanaya-diwali-box-outer-red.jpg?v=1791662423" width="1365" height="2048" loading="eager" alt="">
    </div>
  </section>

  <section class="vdiwali-gifting__festival" id="diwali-gift-boxes">
    <header class="vdiwali-gifting__section-head">
      <p>Our Diwali Gift Boxes</p>
      <h2>Three Ways to Gift Glow</h2>
      <span>Ayurvedic rituals, beautifully packed for your loved ones.</span>
    </header>

    <div class="vdiwali-gifting__grid">
      {% assign diwali_products = box1 | append: '|' %}
      {% render 'vanaya-diwali-gift-card',
        product: box1,
        number: '01',
        badge: '40% OFF',
        subtitle: 'Kansa Wand · Sea Buckthorn 5 ml · Kumkumadi 5 ml · Mirror',
        image_index: 1
      %}
      {% render 'vanaya-diwali-gift-card',
        product: box2,
        number: '02',
        badge: '40% OFF',
        subtitle: 'Kansa Wand · Sea Buckthorn Oil 10 ml',
        image_index: 1
      %}
      {% render 'vanaya-diwali-gift-card',
        product: box3,
        number: '03',
        badge: '30% OFF',
        subtitle: 'Kansa Wand · Choose any one 30 ml Vanaya facial oil',
        image_index: 1,
        show_variant_select: true
      %}
    </div>
  </section>

  <section class="vdiwali-gifting__signature">
    <header class="vdiwali-gifting__section-head">
      <p>Vanaya Signature Gift Boxes</p>
      <h2>Our Original Gifting Rituals</h2>
      <span>Timeless Vanaya gift boxes, available beyond the festive season.</span>
    </header>
    <div class="vdiwali-gifting__signature-grid">
      {% render 'vanaya-diwali-gift-card',
        product: complete_box,
        number: '04',
        badge: 'SIGNATURE',
        subtitle: 'A complete Vanaya face-and-eye ritual',
        image_index: 0
      %}
      {% render 'vanaya-diwali-gift-card',
        product: glow_box,
        number: '05',
        badge: 'SIGNATURE',
        subtitle: 'Vanaya essentials paired with the Kansa Wand',
        image_index: 0
      %}
    </div>
  </section>

  <section class="vdiwali-gifting__closing">
    <div><span>◌</span><strong>Pure & Ayurvedic</strong><small>Thoughtfully formulated rituals</small></div>
    <div><span>◇</span><strong>Beautifully Packaged</strong><small>Ready to gift with love</small></div>
    <div><span>♡</span><strong>Thoughtful & Meaningful</strong><small>Rituals they can return to</small></div>
    <div><span>✦</span><strong>Perfect for Festive Gifting</strong><small>Make this Diwali memorable</small></div>
  </section>
</main>

<style>
.vdiwali-gifting{--red:#7f0f17;--deep:#4f090d;--gold:#d8ad5f;--cream:#fff8eb;--ink:#3d2720;background:var(--cream);color:var(--ink);font-family:"Avenir Next",Avenir,Arial,sans-serif}
.vdiwali-gifting__hero{display:grid;grid-template-columns:1.05fr .95fr;min-height:620px;background:linear-gradient(115deg,#5b090e 0%,#8d1117 55%,#4a090c 100%);color:#fff1cf;overflow:hidden}
.vdiwali-gifting__hero-copy{display:flex;flex-direction:column;justify-content:center;padding:72px clamp(28px,6vw,96px)}
.vdiwali-gifting__kicker{margin:0 0 18px;color:#f2cd79;font-size:11px;font-weight:800;letter-spacing:.34em}
.vdiwali-gifting__hero h1{margin:0;font:400 clamp(64px,7.5vw,116px)/.9 Georgia,serif;letter-spacing:-.045em;color:#ffe4a8}
.vdiwali-gifting__hero h2{margin:18px 0 12px;font:400 clamp(24px,2.5vw,38px)/1.15 Georgia,serif;color:#f8d996}
.vdiwali-gifting__hero-copy>p:not(.vdiwali-gifting__kicker){max-width:650px;margin:0;color:#f6e6d1;font:16px/1.72 Georgia,serif}
.vdiwali-gifting__hero-copy>a{display:inline-flex;width:max-content;align-items:center;gap:12px;margin-top:30px;padding:15px 20px;background:#f3ce80;color:#4f090d;font-size:10px;font-weight:900;letter-spacing:.12em;text-decoration:none;text-transform:uppercase}
.vdiwali-gifting__benefits{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:44px;max-width:760px}
.vdiwali-gifting__benefits span{padding-right:10px;border-right:1px solid rgba(255,232,188,.28);font-size:9px;font-weight:700;line-height:1.45;text-align:center;text-transform:uppercase}
.vdiwali-gifting__benefits span:last-child{border-right:0}
.vdiwali-gifting__hero-visual{position:relative;min-height:620px;overflow:hidden}
.vdiwali-gifting__hero-visual:after{position:absolute;inset:0;background:linear-gradient(90deg,#771016 0%,transparent 35%);content:"";pointer-events:none}
.vdiwali-gifting__hero-visual img{width:100%;height:100%;object-fit:cover;object-position:center 55%}
.vdiwali-gifting__festival,.vdiwali-gifting__signature{padding:72px max(18px,4vw) 86px;background:radial-gradient(circle at 50% 0,rgba(239,196,142,.13),transparent 42%),#fff9ef}
.vdiwali-gifting__signature{background:#fff3e8}
.vdiwali-gifting__section-head{max-width:780px;margin:0 auto 42px;text-align:center}
.vdiwali-gifting__section-head>p{margin:0;color:#8b1b20;font-size:10px;font-weight:900;letter-spacing:.25em;text-transform:uppercase}
.vdiwali-gifting__section-head h2{margin:9px 0 13px;color:#5a1818;font:400 clamp(42px,5vw,68px)/1 Georgia,serif;letter-spacing:-.035em}
.vdiwali-gifting__section-head span{color:#715d51;font:14px/1.6 Georgia,serif}
.vdiwali-gifting__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;max-width:1450px;margin:0 auto}
.vdiwali-gifting__signature-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px;max-width:1020px;margin:0 auto}
.vdiwali-gifting__closing{display:grid;grid-template-columns:repeat(4,1fr);padding:34px max(18px,4vw);background:#f8e4d5;border-top:1px solid rgba(126,38,27,.12)}
.vdiwali-gifting__closing div{display:flex;min-height:100px;align-items:center;justify-content:center;flex-direction:column;padding:10px 20px;border-right:1px solid rgba(126,38,27,.18);text-align:center}
.vdiwali-gifting__closing div:last-child{border-right:0}
.vdiwali-gifting__closing span{color:#a21e24;font-size:22px}.vdiwali-gifting__closing strong{margin:8px 0 4px;font-size:12px}.vdiwali-gifting__closing small{color:#725d50;font-size:10px;line-height:1.45}
@media(max-width:980px){.vdiwali-gifting__hero{grid-template-columns:1fr}.vdiwali-gifting__hero-copy{padding:60px 28px 38px;text-align:center;align-items:center}.vdiwali-gifting__hero-visual{min-height:440px}.vdiwali-gifting__benefits{grid-template-columns:repeat(2,1fr)}.vdiwali-gifting__grid{grid-template-columns:1fr 1fr}.vdiwali-gifting__grid>*:last-child{grid-column:1/-1;max-width:620px;justify-self:center;width:100%}}
@media(max-width:650px){.vdiwali-gifting__hero{min-height:0}.vdiwali-gifting__hero-copy{padding:48px 18px 30px}.vdiwali-gifting__hero h1{font-size:58px}.vdiwali-gifting__hero h2{font-size:24px}.vdiwali-gifting__hero-copy>p:not(.vdiwali-gifting__kicker){font-size:14px}.vdiwali-gifting__hero-visual{min-height:360px}.vdiwali-gifting__benefits{gap:8px;margin-top:30px}.vdiwali-gifting__benefits span{font-size:8px}.vdiwali-gifting__festival,.vdiwali-gifting__signature{padding:52px 12px 62px}.vdiwali-gifting__section-head{margin-bottom:28px}.vdiwali-gifting__section-head h2{font-size:39px}.vdiwali-gifting__grid,.vdiwali-gifting__signature-grid{grid-template-columns:1fr}.vdiwali-gifting__grid>*:last-child{grid-column:auto}.vdiwali-gifting__closing{grid-template-columns:1fr 1fr;padding:22px 8px}.vdiwali-gifting__closing div{border-bottom:1px solid rgba(126,38,27,.13)}}
</style>

{% schema %}
{"name":"Vanaya Diwali Gifting","settings":[],"presets":[{"name":"Vanaya Diwali Gifting"}]}
{% endschema %}
